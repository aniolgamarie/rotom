    "bashInterceptor": {
      "enabled": true,
      "patterns": [
        {
          "pattern": "^\\s*(cat|head|tail|less|more)\\s+",
          "tool": "read",
          "message": "Use the `read` tool instead of cat/head/tail."
        },
        {
          "pattern": "^\\s*(grep|rg|ripgrep|ag|ack)\\s+",
          "tool": "grep",
          "message": "Use the `grep` tool instead of grep/rg."
        },
        {
          "pattern": "^\\s*(find|fd|locate)\\s+.*(-name|-iname|-type|--type|-glob)",
          "tool": "glob",
          "message": "Use the `glob` tool instead of find/fd."
        },
        {
          "pattern": "^\\s*sed\\s+(-i|--in-place)",
          "tool": "edit",
          "message": "Use the `edit` tool instead of sed -i."
        },
        {
          "pattern": "^\\s*nohup\\s+|(?<!&)\\&\\s*$",
          "tool": "hub",
          "message": "Use the `hub` tool (op:\"start\") so the process stays observable."
        }
      ]
    },
