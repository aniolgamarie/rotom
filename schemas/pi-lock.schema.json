{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/pi-lock.schema.json",
  "title": "\u5b98\u65b9 Pi npm \u5b8c\u6574\u9501\uff08Base/Pro \u72ec\u7acb\u6d88\u8d39\uff09",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "adapter_version": {
      "const": "pi-2"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host": {
      "$ref": "#/$defs/source"
    },
    "modules": {
      "type": "object",
      "properties": {
        "catppuccin": {
          "$ref": "#/$defs/source"
        },
        "cache-hit-monitor": {
          "$ref": "#/$defs/source"
        },
        "pi-context7": {
          "$ref": "#/$defs/source"
        },
        "pi-brave": {
          "$ref": "#/$defs/source"
        },
        "pi-footer": {
          "$ref": "#/$defs/source"
        },
        "playwright-cli": {
          "$ref": "#/$defs/source"
        },
        "pi-cursor": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "toolchains": {
      "type": "object",
      "properties": {
        "node": {
          "const": "v22.19.0"
        },
        "npm": {
          "const": "11.9.0"
        }
      },
      "required": [
        "node",
        "npm"
      ],
      "additionalProperties": false
    },
    "platforms": {
      "const": [
        "linux-x86_64"
      ]
    },
    "profiles": {
      "type": "object",
      "properties": {
        "pi-base": {
          "type": "object",
          "properties": {
            "profile": {
              "const": "pi-base"
            },
            "identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipe_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipe_inputs": {
              "$ref": "#/$defs/inputs"
            },
            "closure_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_path": {
              "const": "pi-base/package.json"
            },
            "lock_path": {
              "const": "pi-base/package-lock.json"
            },
            "package_json_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_lock_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "script_audits": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/audit"
              }
            }
          },
          "required": [
            "profile",
            "identity",
            "recipe_digest",
            "recipe_inputs",
            "closure_digest",
            "package_path",
            "lock_path",
            "package_json_digest",
            "package_lock_digest",
            "dependencies",
            "required_files",
            "script_audits"
          ],
          "additionalProperties": false
        },
        "pi-pro": {
          "type": "object",
          "properties": {
            "profile": {
              "const": "pi-pro"
            },
            "identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipe_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipe_inputs": {
              "$ref": "#/$defs/inputs"
            },
            "closure_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_path": {
              "const": "pi-pro/package.json"
            },
            "lock_path": {
              "const": "pi-pro/package-lock.json"
            },
            "package_json_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "package_lock_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dependencies": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "script_audits": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/audit"
              }
            }
          },
          "required": [
            "profile",
            "identity",
            "recipe_digest",
            "recipe_inputs",
            "closure_digest",
            "package_path",
            "lock_path",
            "package_json_digest",
            "package_lock_digest",
            "dependencies",
            "required_files",
            "script_audits"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pi-base",
        "pi-pro"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "adapter_version",
    "identity",
    "host",
    "modules",
    "toolchains",
    "platforms",
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "resolved": {
          "type": "string",
          "pattern": "^https://registry\\.npmjs\\.org/[^?#]+\\.tgz$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        },
        "license_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "license_notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/license_notice"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "package",
        "version",
        "resolved",
        "integrity",
        "license",
        "source_commit",
        "license_files",
        "entries",
        "license_notices"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "license_files": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "license_notices": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "properties": {
        "package_json_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lifecycle": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "preinstall",
              "install",
              "postinstall",
              "prepare"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "const": "ignored_not_required"
        }
      },
      "required": [
        "package_json_digest",
        "lifecycle",
        "decision"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "pi-base",
            "pi-pro"
          ]
        },
        "host": {
          "$ref": "#/$defs/source"
        },
        "modules": {
          "type": "object",
          "properties": {
            "catppuccin": {
              "$ref": "#/$defs/source"
            },
            "cache-hit-monitor": {
              "$ref": "#/$defs/source"
            },
            "pi-context7": {
              "$ref": "#/$defs/source"
            },
            "pi-brave": {
              "$ref": "#/$defs/source"
            },
            "pi-footer": {
              "$ref": "#/$defs/source"
            },
            "playwright-cli": {
              "$ref": "#/$defs/source"
            },
            "pi-cursor": {
              "$ref": "#/$defs/source"
            }
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "plugins": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "cache-hit-monitor",
                  "pi-footer",
                  "pi-cursor"
                ]
              },
              "uniqueItems": true
            },
            "mcp": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pi-context7",
                  "pi-brave"
                ]
              },
              "uniqueItems": true
            },
            "resources": {
              "type": "object",
              "properties": {
                "prompts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "themes": {
                  "type": "array",
                  "items": {
                    "const": "catppuccin"
                  },
                  "uniqueItems": true
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "builtin:codemode",
                      "builtin:tool-search"
                    ]
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "prompts",
                "themes",
                "extensions"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "rules",
            "skills",
            "plugins",
            "mcp",
            "resources"
          ],
          "additionalProperties": false
        },
        "resources": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "rules"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "template": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "source",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "prompt"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "const": "prompt"
                      },
                      "scope": {
                        "const": "global"
                      }
                    },
                    "required": [
                      "path",
                      "kind",
                      "scope"
                    ],
                    "additionalProperties": false
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "source",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "skill-file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "override": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  "mode": {
                    "enum": [
                      384,
                      448
                    ]
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "source",
                  "mode",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "module-support",
                    "type": "string"
                  },
                  "id": {
                    "const": "pi-mcp-launch",
                    "type": "string"
                  },
                  "path": {
                    "const": "agents/pi/support/mcp-launch.py",
                    "type": "string"
                  },
                  "target": {
                    "const": "support/mcp-launch.py",
                    "type": "string"
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "target",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "module-support",
                    "type": "string"
                  },
                  "id": {
                    "const": "pi-status-observer",
                    "type": "string"
                  },
                  "path": {
                    "const": "agents/pi/support/status-observer.mjs",
                    "type": "string"
                  },
                  "target": {
                    "const": "support/status-observer.mjs",
                    "type": "string"
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "target",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "module-support",
                    "type": "string"
                  },
                  "id": {
                    "const": "pi-footer-config",
                    "type": "string"
                  },
                  "path": {
                    "const": "agents/pi/templates/pi-footer.json",
                    "type": "string"
                  },
                  "target": {
                    "const": "support/pi-footer.json",
                    "type": "string"
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "target",
                  "content_identity"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "module-support",
                    "type": "string"
                  },
                  "id": {
                    "const": "pi-browser-launch",
                    "type": "string"
                  },
                  "path": {
                    "const": "agents/pi/support/browser-launch.py",
                    "type": "string"
                  },
                  "target": {
                    "const": "support/browser-launch.py",
                    "type": "string"
                  },
                  "content_identity": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "target",
                  "content_identity"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "toolchains": {
          "type": "object",
          "properties": {
            "node": {
              "const": "v22.19.0"
            },
            "npm": {
              "const": "11.9.0"
            }
          },
          "required": [
            "node",
            "npm"
          ],
          "additionalProperties": false
        },
        "platforms": {
          "const": [
            "linux-x86_64"
          ]
        },
        "script_audits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sourceAudit"
          }
        }
      },
      "required": [
        "profile",
        "host",
        "modules",
        "selection",
        "resources",
        "toolchains",
        "platforms",
        "script_audits"
      ],
      "additionalProperties": false
    },
    "license_notice": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^agents/pi/licenses/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f]+)*$"
        },
        "target_path": {
          "type": "string",
          "pattern": "^licenses/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\x00-\\x1f]+)*$"
        },
        "source_uri": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/earendil-works/pi/[a-f0-9]{40}/LICENSE$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_path",
        "target_path",
        "source_uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "sourceAudit": {
      "type": "object",
      "properties": {
        "package_json_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lifecycle": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "preinstall",
              "install",
              "postinstall",
              "prepare"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "decision": {
          "const": "ignored_not_required"
        },
        "package": {
          "$ref": "#/$defs/source/properties/package"
        },
        "version": {
          "$ref": "#/$defs/source/properties/version"
        }
      },
      "required": [
        "package_json_digest",
        "lifecycle",
        "decision"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "package": [
          "version"
        ],
        "version": [
          "package"
        ]
      }
    }
  }
}
