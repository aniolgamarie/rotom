{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMP permission-control patched runtime",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "variant": {
      "type": "string",
      "const": "permission-control-v1"
    },
    "upstreamIdentity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "bridgeAbi": {
      "type": "string",
      "const": "permission-control/v1"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "buildReceiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "pluginDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "assets": {
      "type": "object",
      "patternProperties": {
        "^(linux|macos|windows)-(x64|arm64)$(?![\\s\\S])": {
          "type": "object",
          "properties": {
            "cacheKey": {
              "type": "string",
              "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "cacheKey",
            "sha256",
            "size"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "variant",
    "upstreamIdentity",
    "bridgeAbi",
    "patches",
    "buildReceiptDigest",
    "pluginDigest",
    "assets",
    "identity"
  ],
  "additionalProperties": false,
  "$defs": {
    "buildReceipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "variant": {
          "type": "string",
          "const": "permission-control-v1"
        },
        "platform": {
          "type": "string",
          "const": "linux-x64"
        },
        "bridgeAbi": {
          "type": "string",
          "const": "permission-control/v1"
        },
        "upstreamIdentity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "upstreamSource": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
            },
            "archiveSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "commit",
            "archiveSha256"
          ],
          "additionalProperties": false
        },
        "dependencyLock": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "buildInputsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "cacheKey": {
                "type": "string",
                "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "name",
              "version",
              "cacheKey",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "dependencyArtifacts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "cacheKey": {
                "type": "string",
                "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "cacheKey",
              "sha256",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "patches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "buildScripts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "pluginDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "asset": {
          "type": "object",
          "properties": {
            "cacheKey": {
              "type": "string",
              "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "cacheKey",
            "sha256",
            "size"
          ],
          "additionalProperties": false
        },
        "networkPolicy": {
          "type": "string",
          "const": "linux-seccomp-no-inet"
        },
        "manager": {
          "type": "object",
          "properties": {
            "implementation": {
              "type": "string",
              "const": "CPython"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "implementation",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "variant",
        "platform",
        "bridgeAbi",
        "upstreamIdentity",
        "upstreamSource",
        "dependencyLock",
        "buildInputsDigest",
        "tools",
        "dependencyArtifacts",
        "patches",
        "buildScripts",
        "pluginDigest",
        "asset",
        "networkPolicy",
        "manager"
      ],
      "additionalProperties": false
    }
  }
}
