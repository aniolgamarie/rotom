{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr benchmark report v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "measurement",
        "calibration",
        "comparison"
      ]
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "candidate_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_main": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "lock_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runner_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_tool_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "candidate_commit",
        "source_digest",
        "target_main",
        "lock_digest",
        "runner_digest",
        "measurement_tool_digest",
        "schema_digest"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rules_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "integration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rules_identity_kind": {
          "enum": [
            "byte-digest",
            "builtin-origin-fingerprint"
          ]
        },
        "integration_identity_kind": {
          "enum": [
            "byte-digest",
            "disabled-origin-fingerprint"
          ]
        }
      },
      "required": [
        "config_digest",
        "rules_digest",
        "integration_digest"
      ],
      "additionalProperties": false
    },
    "subject": {
      "enum": [
        "baseline",
        "candidate"
      ]
    },
    "subject_identity": {
      "type": "object",
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "asset_url": {
          "type": "string",
          "pattern": "^https://github\\.com/herdrdev/herdr/releases/download/[^/]+/[^/]+$"
        },
        "asset_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binary": {
          "const": "<HERDR>"
        },
        "client_version": {
          "type": "string",
          "minLength": 1
        },
        "server_version": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_ref": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "properties": {
            "config_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rules_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "integration_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rules_identity_kind": {
              "enum": [
                "byte-digest",
                "builtin-origin-fingerprint"
              ]
            },
            "integration_identity_kind": {
              "enum": [
                "byte-digest",
                "disabled-origin-fingerprint"
              ]
            }
          },
          "required": [
            "config_digest",
            "rules_digest",
            "integration_digest"
          ],
          "additionalProperties": false
        },
        "acceptance_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "release",
        "tag",
        "commit",
        "asset_url",
        "asset_digest",
        "binary",
        "client_version",
        "server_version",
        "acceptance_ref",
        "inputs",
        "acceptance_digest"
      ],
      "additionalProperties": false
    },
    "scope": {
      "enum": [
        "first-baseline",
        "runtime",
        "full-stack"
      ]
    },
    "authorization_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "isolation": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sentinels_unchanged": {
          "type": "boolean"
        },
        "private_originals_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "verified",
        "evidence_ref",
        "sentinels_unchanged",
        "private_originals_verified"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "normalized_argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cwd_label": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "start_ns": {
            "type": "integer",
            "minimum": 1
          },
          "end_ns": {
            "type": "integer",
            "minimum": 1
          },
          "ready_evidence_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "execution_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "original_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "normalized_argv",
          "cwd_label",
          "exit_code",
          "start_ns",
          "end_ns",
          "ready_evidence_ref",
          "execution_digest",
          "evidence_ref",
          "original_verified"
        ],
        "additionalProperties": false
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "order": {
            "type": "array",
            "items": {
              "enum": [
                "baseline",
                "candidate"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "warmup_seconds": {
            "const": 60
          },
          "measure_seconds": {
            "const": 300
          },
          "start_ns": {
            "type": "integer",
            "minimum": 1
          },
          "end_ns": {
            "type": "integer",
            "minimum": 1
          },
          "identity_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "batch",
          "order",
          "warmup_seconds",
          "measure_seconds",
          "start_ns",
          "end_ns",
          "identity_digest"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workload": {
            "enum": [
              "idle-1",
              "idle-10",
              "idle-30",
              "output-1",
              "output-10",
              "output-30",
              "projects-27",
              "detached-30",
              "clients-size",
              "churn-leak"
            ]
          },
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "metric": {
            "enum": [
              "latency.warm_enter.p95",
              "latency.warm_reuse.p95",
              "latency.new_role.p95",
              "latency.cold.median",
              "latency.attach.p95",
              "cpu.core_seconds",
              "cpu.cores",
              "cpu.per_mib",
              "rss.peak",
              "rss.median",
              "rss.p95",
              "objects.count",
              "processes.count",
              "fd.count",
              "rss.slope",
              "pss",
              "wakeup"
            ]
          },
          "group": {
            "enum": [
              "server",
              "helpers",
              "server_group",
              "client",
              "producer",
              "all"
            ]
          },
          "unit": {
            "enum": [
              "ms",
              "core-seconds",
              "cores",
              "core-seconds/MiB",
              "bytes",
              "bytes/second",
              "count",
              "count/second"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "mode": {
            "enum": [
              "idle",
              "output",
              "record"
            ]
          }
        },
        "required": [
          "workload",
          "batch",
          "metric",
          "group",
          "unit",
          "value",
          "n",
          "reason",
          "samples",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "correctness": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "failure",
              "unverified"
            ]
          },
          "evidence_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "evidence_ref",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "producer": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workload": {
            "enum": [
              "idle-1",
              "idle-10",
              "idle-30",
              "output-1",
              "output-10",
              "output-30",
              "projects-27",
              "detached-30",
              "clients-size",
              "churn-leak"
            ]
          },
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "pane_label": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "idle",
              "output",
              "record"
            ]
          },
          "phase": {
            "enum": [
              "warmup",
              "measure"
            ]
          },
          "start_ns": {
            "type": "integer",
            "minimum": 1
          },
          "end_ns": {
            "type": "integer",
            "minimum": 1
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "cpu_seconds": {
            "type": "number",
            "minimum": 0
          },
          "backpressure_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "workload",
          "batch",
          "pane_label",
          "mode",
          "phase",
          "start_ns",
          "end_ns",
          "lines",
          "bytes",
          "cpu_seconds",
          "backpressure_seconds"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "failure",
              "unverified"
            ]
          },
          "evidence_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "required",
          "status",
          "evidence_ref",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "invalid_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retest_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "validity": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "decision": {
      "enum": [
        "measured",
        "pass",
        "failure",
        "unverified"
      ]
    },
    "comparison_kind": {
      "enum": [
        "first-baseline",
        "runtime",
        "full-stack"
      ]
    },
    "item_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "pass",
              "failure",
              "unverified"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "task_status": {
      "enum": [
        "已完成",
        "进行中",
        "失败待决策",
        "环境不足未验证"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_complete",
        "pid_identity",
        "rss_interval_seconds",
        "client_ready_proven",
        "dimensions_proven",
        "reason",
        "client_version_verified",
        "effective_inputs_verified"
      ],
      "properties": {
        "cpu_complete": {
          "type": "boolean"
        },
        "pid_identity": {
          "const": "pid-and-proc-stat-starttime"
        },
        "rss_interval_seconds": {
          "const": 1
        },
        "client_ready_proven": {
          "type": "boolean"
        },
        "dimensions_proven": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_version_verified": {
          "type": "boolean"
        },
        "effective_inputs_verified": {
          "type": "boolean"
        }
      }
    },
    "baseline_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "paired_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{32}$"
    },
    "paired_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batch": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "workload": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "idle",
              "output",
              "record"
            ]
          },
          "planned_order": {
            "type": "array",
            "items": {
              "enum": [
                "baseline",
                "candidate"
              ]
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "actual_order": {
            "type": "array",
            "items": {
              "enum": [
                "baseline",
                "candidate"
              ]
            },
            "maxItems": 2,
            "uniqueItems": true
          },
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subject": {
                  "enum": [
                    "baseline",
                    "candidate"
                  ]
                },
                "start_ns": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_ns": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "subject",
                "start_ns",
                "end_ns"
              ],
              "additionalProperties": false
            },
            "maxItems": 2
          }
        },
        "required": [
          "batch",
          "workload",
          "mode",
          "planned_order",
          "actual_order",
          "windows"
        ],
        "additionalProperties": false
      }
    },
    "origin_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_ref": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}\\.json$"
          },
          "execution_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rules_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "integration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rules_identity_kind": {
            "const": "builtin-origin-fingerprint"
          },
          "integration_identity_kind": {
            "const": "disabled-origin-fingerprint"
          }
        },
        "required": [
          "evidence_ref",
          "execution_digest",
          "rules_digest",
          "integration_digest",
          "rules_identity_kind",
          "integration_identity_kind"
        ],
        "additionalProperties": false
      }
    },
    "cpu_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "workload": {
            "enum": [
              "idle-1",
              "idle-10",
              "idle-30",
              "output-1",
              "output-10",
              "output-30",
              "projects-27",
              "detached-30",
              "clients-size",
              "churn-leak"
            ]
          },
          "mode": {
            "enum": [
              "idle",
              "output",
              "record"
            ]
          },
          "batch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "method": {
            "const": "cpuacct-v1"
          },
          "completeness_scope": {
            "const": "server-group-descendants"
          },
          "complete": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "execution_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}\\.json$"
          }
        },
        "required": [
          "workload",
          "mode",
          "batch",
          "method",
          "completeness_scope",
          "complete",
          "reason",
          "source_digest",
          "execution_digest",
          "evidence_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "digest",
    "kind",
    "manifest_digest",
    "policy_digest",
    "fixture_digest",
    "source",
    "inputs",
    "subject",
    "subject_identity",
    "scope",
    "authorization_ref",
    "isolation",
    "steps",
    "batches",
    "measurements",
    "correctness",
    "producer",
    "evidence",
    "invalid_reasons",
    "retest_refs",
    "validity",
    "decision",
    "comparison_kind",
    "item_decisions",
    "task_status",
    "reason",
    "coverage",
    "baseline_digest",
    "operation_exit_code",
    "paired_run_id",
    "paired_schedule"
  ],
  "additionalProperties": false
}
