{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "adapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "adapters": {
      "type": "object",
      "required": ["dsh", "pi", "omp"],
      "additionalProperties": false,
      "properties": {
        "dsh": {"$ref": "#/$defs/defaults"},
        "pi": {"$ref": "#/$defs/defaults"},
        "omp": {"$ref": "#/$defs/defaults"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "selection": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "defaults": {
      "type": "object",
      "required": ["providers", "models", "roles"],
      "additionalProperties": false,
      "properties": {
        "providers": {"$ref": "#/$defs/selection"},
        "models": {"$ref": "#/$defs/selection"},
        "roles": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
