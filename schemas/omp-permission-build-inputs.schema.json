{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMP permission-control offline build inputs",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "platform": {
      "type": "string",
      "const": "linux-x64"
    },
    "upstreamSource": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"
        },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "commit",
        "archiveSha256"
      ],
      "additionalProperties": false
    },
    "dependencyLock": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-][A-Za-z0-9_./-]*$(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "cacheKey": {
            "type": "string",
            "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          }
        },
        "required": [
          "name",
          "version",
          "cacheKey",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "dependencyArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "cacheKey": {
            "type": "string",
            "pattern": "^sha256/[0-9a-f]{64}$(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "cacheKey",
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "platform",
    "upstreamSource",
    "dependencyLock",
    "tools",
    "dependencyArtifacts"
  ],
  "additionalProperties": false
}
