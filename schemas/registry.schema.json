{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "providers": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/provider"}},
    "models": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/model"}},
    "mcp": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/mcp"}},
    "rules": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/rule"}},
    "skills": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+(?![\\s\\S])"},
    "secret": {"type": "string", "pattern": "^secret:(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "auth_kind"],
      "properties": {
        "protocol": {"$ref": "#/$defs/text"},
        "base_url": {"$ref": "#/$defs/text"},
        "auth_kind": {"$ref": "#/$defs/text"},
        "credential_ref": {"$ref": "#/$defs/secret"}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "remote_id", "input"],
      "properties": {
        "provider": {"$ref": "#/$defs/id"},
        "remote_id": {"$ref": "#/$defs/text"},
        "context_window": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/text"},
        "input": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}
      }
    },
    "mcp": {
      "type": "object", "additionalProperties": false,
      "required": ["transport"],
      "properties": {
        "transport": {"$ref": "#/$defs/text"},
        "command": {"$ref": "#/$defs/text"},
        "args": {"type": "array", "items": {"type": "string"}},
        "url": {"$ref": "#/$defs/text"},
        "credential_ref": {"$ref": "#/$defs/secret"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "template": {"type": "boolean"}}
    },
    "skill": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "override": {"$ref": "#/$defs/text", "description": "精确指向此前同 ID 技能的仓库相对 path；只允许一次整包替换，保留双方来源"}
      }
    }
  }
}
