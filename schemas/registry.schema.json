{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "providers": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/provider"}},
    "models": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/model"}},
    "mcp": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/mcp"}},
    "rules": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/rule"}},
    "skills": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+(?![\\s\\S])"},
    "secret": {"type": "string", "pattern": "^secret:(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "auth_kind"],
      "properties": {
        "protocol": {"$ref": "#/$defs/text"},
        "base_url": {"$ref": "#/$defs/text"},
        "base_url_ref": {"$ref": "#/$defs/local_ref"},
        "auth_kind": {"$ref": "#/$defs/text"},
        "credential_ref": {"$ref": "#/$defs/secret"},
        "omp_auth_header": {"type": "boolean"}
      }
    },
    "local_ref": {"type": "string", "pattern": "^local:(?!\\.{1,2}$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "remote_id", "input"],
      "properties": {
        "provider": {"$ref": "#/$defs/id"},
        "remote_id": {"$ref": "#/$defs/text"},
        "context_window": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_output_supported": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/text"},
        "name": {"$ref": "#/$defs/text"},
        "reasoning": {"type": "boolean"},
        "reasoning_efforts": {"type": "array", "items": {"type": "string", "enum": ["low", "high", "max"]}, "uniqueItems": true},
        "pricing": {"$ref": "#/$defs/pricing"},
        "native": {"$ref": "#/$defs/native_model"},
        "input": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}
      }
    },
    "price_rates": {
      "type": "object", "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "number", "minimum": 0},
        "output": {"type": "number", "minimum": 0},
        "cache_read": {"type": "number", "minimum": 0},
        "cache_write": {"type": "number", "minimum": 0}
      }
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "per_tokens", "source", "checked_on", "standard"],
      "dependentRequired": {"off_peak": ["schedule"]},
      "properties": {
        "currency": {"type": "string", "enum": ["USD", "CNY"]},
        "per_tokens": {"type": "integer", "const": 1000000},
        "source": {"$ref": "#/$defs/text"},
        "checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "standard": {"$ref": "#/$defs/price_rates"},
        "off_peak": {"$ref": "#/$defs/price_rates"},
        "schedule": {"$ref": "#/$defs/text"}
      }
    },
    "native_model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pi": {"type": "object", "additionalProperties": false, "properties": {
          "compat": {"type": "object", "additionalProperties": false, "properties": {
            "requiresReasoningContentOnAssistantMessages": {"type": "boolean"},
            "thinkingFormat": {"type": "string", "enum": ["deepseek"]},
            "reasoningEffortMap": {"type": "object", "additionalProperties": false, "properties": {
              "minimal": {"type": "string", "enum": ["low", "high", "max"]},
              "low": {"type": "string", "enum": ["low", "high", "max"]},
              "medium": {"type": "string", "enum": ["low", "high", "max"]},
              "high": {"type": "string", "enum": ["low", "high", "max"]},
              "xhigh": {"type": "string", "enum": ["low", "high", "max"]},
              "max": {"type": "string", "enum": ["low", "high", "max"]}
            }}
          }}
        }},
        "omp": {"type": "object", "additionalProperties": false, "properties": {
          "thinking": {"type": "object", "additionalProperties": false, "properties": {
            "minLevel": {"$ref": "#/$defs/text"}, "maxLevel": {"$ref": "#/$defs/text"},
            "mode": {"type": "string", "enum": ["effort"]}
          }},
          "compat": {"type": "object", "additionalProperties": false, "properties": {
            "supportsDeveloperRole": {"type": "boolean"},
            "supportsReasoningEffort": {"type": "boolean"},
            "maxTokensField": {"type": "string", "enum": ["max_tokens"]},
            "reasoningEffortMap": {"type": "object", "additionalProperties": false, "properties": {
              "minimal": {"type": "string", "enum": ["low", "high", "max"]},
              "low": {"type": "string", "enum": ["low", "high", "max"]},
              "medium": {"type": "string", "enum": ["low", "high", "max"]},
              "high": {"type": "string", "enum": ["low", "high", "max"]},
              "xhigh": {"type": "string", "enum": ["low", "high", "max"]},
              "max": {"type": "string", "enum": ["low", "high", "max"]}
            }},
            "supportsToolChoice": {"type": "boolean"},
            "requiresReasoningContentForToolCalls": {"type": "boolean"},
            "requiresAssistantContentForToolCalls": {"type": "boolean"},
            "extraBody": {"type": "object", "additionalProperties": false, "properties": {
              "thinking": {"type": "object", "additionalProperties": false, "properties": {
                "type": {"type": "string", "enum": ["enabled"]}
              }}
            }}
          }}
        }}
      }
    },
    "mcp": {
      "type": "object", "additionalProperties": false,
      "required": ["transport"],
      "properties": {
        "transport": {"$ref": "#/$defs/text"},
        "command": {"$ref": "#/$defs/text"},
        "args": {"type": "array", "items": {"type": "string"}},
        "url": {"$ref": "#/$defs/text"},
        "credential_ref": {"$ref": "#/$defs/secret"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "template": {"type": "boolean"}}
    },
    "skill": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "override": {"$ref": "#/$defs/text", "description": "精确指向此前同 ID 技能的仓库相对 path；只允许一次整包替换，保留双方来源"}
      }
    }
  }
}
