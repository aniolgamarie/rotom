{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "identity", "recipe", "node", "npm", "pnpm", "adapter_version", "platforms", "upstream", "npm_integrity", "pnpm_integrity"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "enum": [1, 2]},
    "resolution_kind": {"type": "string", "const": "pnpm"},
    "identity": {"$ref": "#/$defs/sha256"},
    "recipe": {"$ref": "#/$defs/sha256"},
    "node": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "npm": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "pnpm": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "adapter_version": {"type": "string", "minLength": 1},
    "platforms": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "upstream": {
      "type": "object", "required": ["host", "tui", "cursor"], "additionalProperties": false,
      "properties": {
        "host": {"$ref": "#/$defs/sha1"}, "tui": {"$ref": "#/$defs/sha1"},
        "cursor": {"$ref": "#/$defs/sha1"}
      }
    },
    "npm_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+=*$"},
    "pnpm_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+=*$"},
    "minimum_release_age_exclude": {
      "type": "array", "maxItems": 1024, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(dsh-auto-review@[0-9]+\\.[0-9]+\\.[0-9]+|@deepseek-harness-tui/dsh-tui@[0-9]+\\.[0-9]+\\.[0-9]+|@deepseek-ai/dsh(-[a-z0-9-]+)?@[0-9]+\\.[0-9]+\\.[0-9]+-(alpha|beta|rc)\\.[0-9]+)$"}
    },
    "install_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default": {"type": "string"},
        "audited_steps": {"type": "array", "items": {"type": "string"}},
        "linux_frozen_install": {"type": "string"}, "macos_frozen_install": {"type": "string"},
        "audited_helper_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [{"if": {"properties": {"version": {"const": 2}}}, "then": {"required": ["resolution_kind"]}, "else": {"not": {"required": ["resolution_kind"]}}}],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
