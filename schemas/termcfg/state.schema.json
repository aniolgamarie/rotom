{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "termcfg private non-secret state",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "machine_id",
        "targets",
        "previous"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "machine_id": {
          "type": "string"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/v2_record"
          }
        },
        "previous": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "zsh",
              "tmux",
              "herdr"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/v2_backup"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "machine_id",
        "targets",
        "previous"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 3
        },
        "machine_id": {
          "type": "string"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/v3_record"
          }
        },
        "previous": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "zsh",
              "tmux",
              "herdr"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/v3_backup"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "v2_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "absent",
            "file",
            "symlink"
          ]
        },
        "uid": {
          "type": "integer"
        },
        "dev": {
          "type": "integer"
        },
        "ino": {
          "type": "integer"
        },
        "mode": {
          "type": "integer"
        },
        "mtime_ns": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "digest": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      }
    },
    "v2_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "after",
        "source_digest"
      ],
      "properties": {
        "component": {
          "enum": [
            "zsh",
            "tmux",
            "herdr"
          ]
        },
        "after": {
          "$ref": "#/$defs/v2_identity"
        },
        "source_digest": {
          "type": "string"
        }
      }
    },
    "v2_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "transaction_id",
        "phase",
        "plan_id",
        "state_before",
        "items"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "kind": {
          "enum": [
            "apply",
            "rollback"
          ]
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "phase": {
          "enum": [
            "prepared",
            "backed_up",
            "writing",
            "committed",
            "recovery_pending",
            "recovered"
          ]
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state_before": {
          "type": "object"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "component",
              "relative",
              "before",
              "desired",
              "mode",
              "backup",
              "after",
              "stage"
            ],
            "properties": {
              "target_id": {
                "type": "string"
              },
              "component": {
                "enum": [
                  "zsh",
                  "tmux",
                  "herdr"
                ]
              },
              "relative": {
                "type": "string"
              },
              "before": {
                "$ref": "#/$defs/v2_identity"
              },
              "desired": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "backup": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v2_backup"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intended_after": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v2_identity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recovery_intended": {
                "$ref": "#/$defs/v2_identity"
              },
              "expected_restore": {
                "$ref": "#/$defs/v2_identity"
              },
              "after": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v2_identity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "enum": [
                  "pending",
                  "verified",
                  "recovered"
                ]
              }
            }
          }
        }
      }
    },
    "v2_backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "path"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/v2_identity"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_before": {
          "type": "boolean"
        },
        "prior_source_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "v3_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "absent",
            "file",
            "symlink"
          ]
        },
        "uid": {
          "type": "integer"
        },
        "dev": {
          "type": "integer"
        },
        "ino": {
          "type": "integer"
        },
        "mode": {
          "type": "integer"
        },
        "mtime_ns": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "digest": {
          "type": "string"
        },
        "link": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "maxProperties": 1
        },
        {
          "properties": {
            "kind": {
              "const": "file"
            }
          },
          "required": [
            "kind",
            "uid",
            "dev",
            "ino",
            "mode",
            "mtime_ns",
            "size",
            "digest"
          ],
          "not": {
            "required": [
              "link"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "symlink"
            }
          },
          "required": [
            "kind",
            "uid",
            "dev",
            "ino",
            "mode",
            "mtime_ns",
            "size",
            "link"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "v3_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "after",
        "source_digest"
      ],
      "properties": {
        "component": {
          "enum": [
            "zsh",
            "tmux",
            "herdr"
          ]
        },
        "after": {
          "$ref": "#/$defs/v3_identity"
        },
        "source_digest": {
          "type": "string"
        },
        "generated": {
          "$ref": "#/$defs/v3_generated"
        }
      }
    },
    "v3_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "transaction_id",
        "phase",
        "plan_id",
        "state_before",
        "items"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 3
        },
        "kind": {
          "enum": [
            "apply",
            "rollback"
          ]
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "phase": {
          "enum": [
            "prepared",
            "backed_up",
            "writing",
            "committed",
            "recovery_pending",
            "recovered",
            "activated"
          ]
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state_before": {
          "type": "object"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "component",
              "relative",
              "before",
              "desired",
              "mode",
              "backup",
              "after",
              "stage"
            ],
            "properties": {
              "target_id": {
                "type": "string"
              },
              "component": {
                "enum": [
                  "zsh",
                  "tmux",
                  "herdr"
                ]
              },
              "relative": {
                "type": "string"
              },
              "before": {
                "$ref": "#/$defs/v3_identity"
              },
              "desired": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "backup": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v3_backup"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "intended_after": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v3_identity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recovery_intended": {
                "$ref": "#/$defs/v3_identity"
              },
              "expected_restore": {
                "$ref": "#/$defs/v3_identity"
              },
              "after": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/v3_identity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "enum": [
                  "pending",
                  "verified",
                  "recovered"
                ]
              },
              "generated": {
                "$ref": "#/$defs/v3_generated"
              }
            }
          }
        }
      }
    },
    "v3_backup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "path"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/v3_identity"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_before": {
          "type": "boolean"
        },
        "prior_source_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "prior_generated": {
          "$ref": "#/$defs/v3_generated"
        }
      }
    },
    "v3_generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "generator_version",
        "source_inputs_digest",
        "payload"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "rotom-entry-binding"
        },
        "generator_version": {
          "type": "integer",
          "const": 1
        },
        "source_inputs_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative",
            "sha256",
            "mode"
          ],
          "properties": {
            "relative": {
              "type": "string",
              "pattern": "^payloads/[0-9a-f]{32}/rotom-entry-binding\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mode": {
              "type": "integer",
              "const": 384
            }
          }
        }
      }
    },
    "journal": {
      "oneOf": [
        {
          "$ref": "#/$defs/v2_journal"
        },
        {
          "$ref": "#/$defs/v3_journal"
        }
      ]
    }
  }
}
