{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "termcfg machine selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "target_home", "private_state_root", "components"],
  "properties": {
    "machine_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "target_home": {"type": "string", "minLength": 1},
    "private_state_root": {"type": "string", "minLength": 1},
    "components": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["zsh", "tmux", "mihomo"]}
    }
  }
}
