#!/usr/bin/env python3
"""通过已准备的仓库环境运行 Rotom。"""
import sys
sys.dont_write_bytecode = True
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PYTHON = ROOT / ".venv" / "bin" / "python"


def main():
  if not PYTHON.is_file() or not os.access(PYTHON, os.X_OK):
    print("rotom_environment_not_prepared: uv sync --locked", file=sys.stderr)
    return 5
  if Path(sys.prefix).resolve() != (ROOT / ".venv").resolve():
    if Path(sys.executable).absolute() == PYTHON:
      print("rotom_environment_invalid: uv sync --locked", file=sys.stderr)
      return 5
    try:
      os.execv(str(PYTHON), [str(PYTHON), "-B", __file__, *sys.argv[1:]])
    except OSError:
      return 5
  if sys.version_info < (3, 11):
    return 5
  sys.path.insert(0, str(ROOT / "src"))
  from rotom.cli import main as cli_main
  return cli_main()


if __name__ == "__main__":
  raise SystemExit(main())
