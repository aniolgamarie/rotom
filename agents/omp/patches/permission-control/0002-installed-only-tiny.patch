index 0000000..3464e49
--- /dev/null
+++ b/packages/coding-agent/src/permission-control/tiny-installed.ts
@@ -0,0 +1,118 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import { getTinyModelsCacheDir, isCompiledBinary } from "@oh-my-pi/pi-utils";
+import { workerHostEntry } from "@oh-my-pi/pi-utils/worker-host";
+import type { ModelReply, ReviewServices, SingleReviewCall } from "./core/reviewer";
+
+export const PERMISSION_TINY_WORKER = "__omp_worker_permission_tiny";
+export interface TinyResources { modelRoot: string; runtimeRoot: string; version: string }
+function ordinary(file: string, directory = false): fs.Stats {
+  const absolute = path.resolve(file);
+  if (fs.realpathSync(absolute) !== absolute) throw new Error("PERMISSION_TINY_UNAVAILABLE");
+  const stat = fs.lstatSync(absolute);
+  if (stat.isSymbolicLink() || !(directory ? stat.isDirectory() : stat.isFile()) ||
+      typeof process.geteuid === "function" && ![0, process.geteuid()].includes(stat.uid))
+    throw new Error("PERMISSION_TINY_UNAVAILABLE");
+  return stat;
+}
+function json(file: string): any {
+  if (ordinary(file).size > 4 * 1024 * 1024) throw new Error("PERMISSION_TINY_UNAVAILABLE");
+  return JSON.parse(fs.readFileSync(file, "utf8"));
+}
+
+/** 只检查已安装目录；完整性还须独立worker成功完成local-only pipeline加载。 */
+export function inspectInstalledTiny(cacheRoot: string, version: string): Readonly<TinyResources> | undefined {
+  try {
+    if (!/^\d+\.\d+\.\d+(?:[-.][A-Za-z0-9.-]+)?$/u.test(version)) return undefined;
+    const modelRoot = path.join(cacheRoot, "LiquidAI/LFM2.5-230M-ONNX");
+    const runtimeRoot = path.join(path.dirname(cacheRoot), "tiny-title-runtime", `transformers-${version}`);
+    ordinary(modelRoot, true); ordinary(runtimeRoot, true);
+    const config = json(path.join(modelRoot, "config.json"));
+    if (config.model_type !== "lfm2") return undefined;
+    json(path.join(modelRoot, "tokenizer_config.json"));
+    if (ordinary(path.join(modelRoot, "tokenizer.json")).size === 0 ||
+        ordinary(path.join(modelRoot, "onnx/model_q4.onnx")).size === 0) return undefined;
+    const manifest = json(path.join(runtimeRoot, "node_modules/@huggingface/transformers/package.json"));
+    if (manifest.version !== version || manifest.main !== "./dist/transformers.node.cjs") return undefined;
+    ordinary(path.join(runtimeRoot, "node_modules/@huggingface/transformers/dist/transformers.node.cjs"));
+    const stub = path.join(runtimeRoot, "omp-sharp-stub.cjs");
+    if (ordinary(stub).size !== 21 || fs.readFileSync(stub, "utf8") !== "module.exports = {};\n") return undefined;
+    return Object.freeze({ modelRoot, runtimeRoot, version });
+  } catch { return undefined; }
+}
+
+interface OutputReader {
+  read(): Promise<{ done: boolean; value?: Uint8Array }>;
+  cancel(): Promise<void>;
+}
+async function nextLine(reader: OutputReader, state: { bytes: Uint8Array }): Promise<any> {
+  for (;;) {
+    const index = state.bytes.indexOf(10);
+    if (index >= 0) {
+      const line = state.bytes.slice(0, index); state.bytes = state.bytes.slice(index + 1);
+      return JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(line));
+    }
+    const { done, value } = await reader.read();
+    if (done || !value || state.bytes.length + value.length > 16 * 1024) throw new Error("PERMISSION_TINY_UNAVAILABLE");
+    const next = new Uint8Array(state.bytes.length + value.length);
+    next.set(state.bytes); next.set(value, state.bytes.length); state.bytes = next;
+  }
+}
+
+/** 一个请求拥有一个短命独立进程，不连接标题socket、不调用安装器。 */
+export function createTinyInstalledOnly(expected: Readonly<Pick<SingleReviewCall, "requestId" | "deadline" | "signal">>):
+    ReviewServices["tinyInstalledOnly"] {
+  let attempted = false;
+  const binding = { ...expected };
+  return async call => {
+    if (attempted || !Number.isFinite(call.deadline) || !Number.isFinite(binding.deadline) ||
+        call.requestId !== binding.requestId || call.deadline > binding.deadline ||
+        binding.signal.aborted || call.signal.aborted || performance.now() >= call.deadline)
+      return { status: "cancelled" };
+    attempted = true;
+    if (call.installedOnly !== true || call.model.provider !== "local" || call.model.model !== "lfm2.5-230m" ||
+        call.maxOutputTokens !== 128 || call.maxOutputBytes !== 1024 || new TextEncoder().encode(call.input).length > 8192 ||
+        process.platform !== "linux" || process.arch !== "x64") return { status: "unavailable" };
+    const version = process.env.PI_TINY_TRANSFORMERS_VERSION;
+    const resources = version && inspectInstalledTiny(getTinyModelsCacheDir(), version);
+    const entry = workerHostEntry();
+    if (!resources || !isCompiledBinary() && !entry) return { status: "unavailable" };
+    let child: ReturnType<typeof Bun.spawn> | undefined;
+    let reader: OutputReader | undefined;
+    let timeout = false;
+    let stopped = false;
+    const stop = () => { if (stopped) return; stopped = true; try { child?.kill("SIGKILL"); } catch {} };
+    const timer = setTimeout(() => { timeout = true; stop(); }, Math.max(0, Math.min(5000, call.deadline - performance.now())));
+    binding.signal.addEventListener("abort", stop, { once: true });
+    call.signal.addEventListener("abort", stop, { once: true });
+    const cancelled = () => binding.signal.aborted || call.signal.aborted;
+    try {
+      if (cancelled() || performance.now() >= call.deadline) return { status: "cancelled" };
+      child = Bun.spawn({ cmd: [process.execPath, ...(isCompiledBinary() ? [] : [entry!]), PERMISSION_TINY_WORKER],
+        env: { PATH: "/usr/bin:/bin", HOME: process.env.HOME ?? "/nonexistent", LANG: "C.UTF-8",
+          HF_HUB_OFFLINE: "1", TRANSFORMERS_OFFLINE: "1" }, stdin: "pipe", stdout: "pipe", stderr: "ignore" });
+      const input = child.stdin;
+      if (!input || typeof input === "number" || !child.stdout || typeof child.stdout === "number")
+        throw new Error("PERMISSION_TINY_UNAVAILABLE");
+      const output = child.stdout.getReader();
+      reader = output;
+      input.write(`${JSON.stringify({ type: "load", resources })}\n`); await input.flush();
+      const state = { bytes: new Uint8Array() };
+      const ready = await nextLine(output, state);
+      if (ready?.state !== "ready" || Object.keys(ready).length !== 1) return { status: "unavailable" };
+      if (cancelled() || timeout || performance.now() >= call.deadline) return { status: cancelled() ? "cancelled" : "timeout" };
+      call.onInferenceStarted();
+      input.write(`${JSON.stringify({ type: "generate", input: call.input })}\n`); await input.flush();
+      const reply = await nextLine(output, state);
+      if (cancelled() || timeout || performance.now() >= call.deadline) return { status: cancelled() ? "cancelled" : "timeout" };
