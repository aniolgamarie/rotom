+
+/** Pure synchronous search-chain proof. It reads metadata only and never invokes direnv. */
+export function inspectPermissionControlDirenvSearchChain(startDir: string): PermissionControlDirenvSearchEvidence {
+	const chain: unknown[] = [];
+	let dir = path.resolve(startDir);
+	try {
+		for (;;) {
+			const dirStat = fsSync.statSync(dir);
+			if (!dirStat.isDirectory()) throw new Error("NOT_DIRECTORY");
+			const candidate = path.join(dir, ".envrc");
+			let envrc: unknown = null;
+			try {
+				const stat = fsSync.statSync(candidate);
+				envrc = [stat.dev, stat.ino, stat.mode, stat.size, stat.mtimeMs, stat.isFile()];
+			} catch (error) {
+				if (!(error instanceof Error) || !("code" in error) || error.code !== "ENOENT") throw error;
+			}
+			chain.push([dir, dirStat.dev, dirStat.ino, dirStat.mode, dirStat.mtimeMs, envrc]);
+			if (envrc !== null) {
+				return Object.freeze({
+					complete: true,
+					hasEffectiveConfig: true,
+					searchChainFingerprint: new Bun.CryptoHasher("sha256").update(JSON.stringify(chain)).digest("hex"),
+				});
+			}
+			const parent = path.dirname(dir);
+			if (parent === dir) break;
+			dir = parent;
+		}
+		return Object.freeze({
+			complete: true,
+			hasEffectiveConfig: false,
+			searchChainFingerprint: new Bun.CryptoHasher("sha256").update(JSON.stringify(chain)).digest("hex"),
+		});
+	} catch {
+		return Object.freeze({
+			complete: false,
+			hasEffectiveConfig: false,
+			searchChainFingerprint: "0".repeat(64),
+		});
+	}
+}
