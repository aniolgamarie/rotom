+	const record = planRecords.get(plan) as PlanRecord<TArgs, TResult> | undefined;
+	if (!record) fail("PLAN_UNKNOWN");
+	if (record.state === "consumed") fail("PLAN_ALREADY_CONSUMED");
+	if (record.state === "invalidated") fail("PLAN_INVALIDATED");
+	if (record.adapter !== adapter) fail("PLAN_ADAPTER_MISMATCH");
+	if (plan.coverage_state !== "eligible") fail("PLAN_MANUAL_REQUIRED");
+	if (record.prepareSignal?.aborted || current.signal?.aborted) fail("PLAN_CANCELLED");
+	if (
+		current.requestId !== record.requestId ||
+		current.sessionId !== record.sessionId ||
+		current.generation !== record.generation ||
+		current.executionBinding !== record.bindingDigest
+	)
+		fail("PLAN_CONTEXT_CHANGED");
+	if (!adapter.stage) fail("PLAN_MANUAL_REQUIRED");
+	let value: unknown;
+	try {
+		value = await adapter.stage(record.snapshot, current.signal ?? record.prepareSignal);
+	} catch (error) {
+		record.state = "invalidated";
+		try {
+			adapter.invalidate?.(record.snapshot);
+		} catch {
+			// The stage failure remains authoritative.
+		}
+		throw error;
+	}
+	if (record.prepareSignal?.aborted || current.signal?.aborted) {
+		try {
+			adapter.cancelStage?.(value);
+		} finally {
+			record.state = "invalidated";
+		}
+		fail("PLAN_CANCELLED");
+	}
+	const staged = Object.freeze({
+		staged_execution_id: Object.freeze({ kind: "permission-control-staged-execution" as const }),
+	});
+	stageRecords.set(staged, { plan, value, state: "staged" });
+	return staged;
+}
+
+export function startStagedBashExecution<TArgs, TResult>(
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>,
+	plan: PreparedBashExecution,
+	staged: StagedBashExecution,
+	current: Readonly<CommitPreparedBashExecutionContext>,
+	onBeforeStart: () => void = () => {},
+): Promise<TResult> {
+	const record = planRecords.get(plan) as PlanRecord<TArgs, TResult> | undefined;
+	const stage = stageRecords.get(staged);
+	if (!record || !stage || stage.plan !== plan) fail("PLAN_UNKNOWN");
+	if (stage.state !== "staged" || record.state === "consumed") fail("PLAN_ALREADY_CONSUMED");
+	if (record.state === "invalidated") fail("PLAN_INVALIDATED");
+	const cancel = (): never => {
+		stage.state = "cancelled";
+		record.state = "invalidated";
+		adapter.cancelStage?.(stage.value);
+		adapter.invalidate?.(record.snapshot);
+		return fail("PLAN_CONTEXT_CHANGED");
+	};
+	if (
+		record.adapter !== adapter ||
+		current.requestId !== record.requestId ||
+		current.sessionId !== record.sessionId ||
+		current.generation !== record.generation ||
+		current.executionBinding !== record.bindingDigest
+	)
+		return cancel();
+	if (record.prepareSignal?.aborted || current.signal?.aborted) {
+		stage.state = "cancelled";
+		record.state = "invalidated";
+		adapter.cancelStage?.(stage.value);
+		adapter.invalidate?.(record.snapshot);
+		fail("PLAN_CANCELLED");
+	}
+	if (!adapter.start) fail("PLAN_MANUAL_REQUIRED");
+	const cancelUnstarted = (): void => {
+		if (stage.state !== "staged") return;
+		stage.state = "cancelled";
+		record.state = "invalidated";
+		try {
+			adapter.cancelStage?.(stage.value);
+		} catch {
+			// The start failure remains authoritative and the plan stays invalidated.
+		}
+		try {
+			adapter.invalidate?.(record.snapshot);
+		} catch {
+			// Invalidation is already final; adapter cleanup cannot restore the plan.
+		}
+	};
+	try {
+		const result = adapter.start(record.snapshot, stage.value, () => {
+			if (record.prepareSignal?.aborted || current.signal?.aborted || !adapter.revalidate(record.snapshot)) {
+				cancelUnstarted();
+				fail("PLAN_REVALIDATION_FAILED");
+			}
+			onBeforeStart();
+			stage.state = "started";
+			record.state = "consumed";
+		});
+		return result.catch(error => {
+			cancelUnstarted();
+			throw error;
+		});
+	} catch (error) {
+		cancelUnstarted();
+		throw error;
+	}
+}
diff --git a/packages/coding-agent/src/permission-control/execution-host.ts b/packages/coding-agent/src/permission-control/execution-host.ts
new file mode 100644
index 0000000..3ebce26
--- /dev/null
+++ b/packages/coding-agent/src/permission-control/execution-host.ts
@@ -0,0 +1,360 @@
+import {
+	type ExecutionBinding,
+	type ExecutionPermit,
+	type HumanDecision,
+	type PermissionDecision,
+	PermissionLedger,
+} from "./core/controller";
+import { assessBeforeReview, synthesizeReview, type PolicyInput } from "./core/policy";
+import type { NativeConstraint, ReviewPipelineResult } from "./core/reviewer";
+import { analyzeShell, type ShellAnalysis } from "./core/shell-analysis";
+import type { NativePermissionControl } from "./core/types";
+import type { PreparedBashExecution } from "./bridge";
+
+export interface PermissionAuthorizationContext {
+	complete: boolean;
+	messages: readonly Readonly<{ messageId: string; text: string }>[];
+}
+
+export interface HostPermissionBashExecution<T> {
+	requestId: string;
+	prepare(): PreparedBashExecution;
+	/** Host-owned keyed/session-salted operation digest; never exposes its salt. */
+	operationDigest?(command: Uint8Array): string;
+	nativeConstraints(plan: PreparedBashExecution): readonly NativeConstraint[];
+	review?(
+		input: Readonly<{
+			requestId: string;
+			plan: PreparedBashExecution;
+			analysis: ShellAnalysis;
+			nativeConstraints: readonly NativeConstraint[];
+			authorization: PermissionAuthorizationContext;
+			startedAt: number;
+			signal: AbortSignal;
+		}>,
+	): Promise<ReviewPipelineResult | undefined>;
+	audit?(
+		input: Readonly<{
+			binding: ExecutionBinding;
+			decision: PermissionDecision;
+			human?: HumanDecision;
+			review?: ReviewPipelineResult;
+			plan: PreparedBashExecution;
+			analysisComplete: boolean;
+			startedAt: number;
+			permit: "none" | "pending" | "consumed" | "invalidated";
+		}>,
+	): Promise<boolean>;
+	settingsRevision(): number;
+	signal?: AbortSignal;
+	ask(reason: string): Promise<boolean>;
+	stage(signal: AbortSignal): Promise<unknown>;
+	start(staged: unknown, onBeforeStart: () => void): Promise<T>;
+	manualStart(): Promise<T>;
+	cancel(): void;
+}
+
+function digest(value: unknown): string {
+	const stable = (item: unknown): unknown => {
+		if (Array.isArray(item)) return item.map(stable);
+		if (item && typeof item === "object")
+			return Object.fromEntries(
+				Object.keys(item)
+					.sort()
+					.map(key => [key, stable((item as Record<string, unknown>)[key])]),
+			);
+		return item;
+	};
+	return new Bun.CryptoHasher("sha256").update(JSON.stringify(stable(value))).digest("hex");
+}
+
+function binding(
+	input: HostPermissionBashExecution<unknown>,
+	plan: PreparedBashExecution,
+	ledger: PermissionLedger,
+	config: NativePermissionControl,
+	authorization: PermissionAuthorizationContext,
+): ExecutionBinding {
+	const host = ledger.hostState();
+	return {
+		request_id: input.requestId,
+		session_id: ledger.sessionId,
+		generation: ledger.generation,
+		prepared_execution_id: plan.prepared_execution_id,
+		execution_ref: plan.execution_binding.local_ref,
+		execution_digest: plan.execution_binding.digest,
+		operation_digest: input.operationDigest?.(plan.final_command) ?? digest([...plan.final_command]),
+		argv_digest: digest(plan.final_args),
+		cwd: plan.execution_context.cwd,
+		shell_digest: digest(plan.execution_context.shell),
+		backend: plan.execution_context.backend,
+		target_digest: plan.execution_context.targetFingerprint,
+		authorization_digest: digest(authorization),
+		mode: ledger.mode,
+		policy_version: config.policyVersion,
+		reviewer_identity: host.reviewer,
+		plugin_digest: config.pluginDigest,
+		runtime_identity: config.runtimeIdentity,
+		health_digest: digest({ host, settingsRevision: input.settingsRevision() }),
+	};
+}
+
+/** One session-owned transaction from analysis through synchronous backend start. */
+export async function executeHostPermissionBash<T>(
+	ledger: PermissionLedger,
+	config: NativePermissionControl,
+	authorizationContext: () => PermissionAuthorizationContext,
+	input: HostPermissionBashExecution<T>,
+): Promise<T> {
+	return ledger.runSerialized(async queueSignal => {
+		// Queue time is outside the request budget. Preparation is the first
+		// request-local operation and therefore establishes the monotonic origin.
+		const startedAt = performance.now();
+		const plan = input.prepare();
+		let terminal:
+			| Readonly<{
+					binding: ExecutionBinding;
+					decision: PermissionDecision;
+					human?: HumanDecision;
+					review?: ReviewPipelineResult;
+					analysisComplete: boolean;
+			  }>
+			| undefined;
+		let preflightRecorded = false;
+		let consumed = false;
+		try {
+			const initialAuthorization = authorizationContext();
+			const audit = async (value: Parameters<NonNullable<typeof input.audit>>[0]) => {
+				try {
+					return input.audit ? await input.audit(value) : true;
+				} catch {
+					return false;
+				}
+			};
+			const queueTerminalAudit = (permit: "consumed" | "invalidated") => {
+				if (!terminal || !preflightRecorded) return;
+				void audit({ ...terminal, plan, startedAt, permit })
+					.then(ok => {
+						if (!ok) ledger.invalidate("health-changed");
+					})
+					.catch(() => {
+						try {
+							ledger.invalidate("health-changed");
+						} catch {}
+					});
+			};
+			const initial = binding(input, plan, ledger, config, initialAuthorization);
+			const handle = ledger.beginRequest(initial, queueSignal);
+			const nativeConstraints = input.nativeConstraints(plan);
+			const analysis = plan.analysis_context
+				? analyzeShell(new Uint8Array(plan.final_command), plan.analysis_context)
+				: {
+						status: "unknown" as const,
+						commands: [],
+						effects: [
+							{
+								effectId: "effect-1",
+								kind: "unknown" as const,
+								target: "unknown",
+								parameters: [],
+								cwdCategory: "unknown" as const,
+								risk: "unknown" as const,
+							},
+						],
+						unknowns: ["unresolved-target" as const],
+					};
+			const host = ledger.hostState();
+			const analysisComplete = analysis.status === "complete";
+			const policyInput: PolicyInput = {
+				mode: ledger.mode,
+				effects: analysis.effects,
+				analysisComplete,
+				nativeConstraints,
+				restrictionFacts: {
+					generation: initial.generation,
+					currentGeneration: ledger.generation,
+					contextComplete: initialAuthorization.complete,
+					uninterpretedUserText: initialAuthorization.messages.length > 0,
+					structuredRestrictions: [],
+				},
+				hardProhibited: nativeConstraints.some(item => item.policy === "deny"),
+				mechanical: {
+					coverageVerified: plan.coverage_state === "eligible",
+					healthVerified: host.identity_verified && host.bridge_health === "healthy",
+					contextComplete: initialAuthorization.complete,
+					redactionComplete: true,
+					targetProofVerified: analysis.status === "complete",
+					generationVerified: initial.generation === ledger.generation,
+				},
+			};
+			const before = assessBeforeReview(policyInput);
+			const reviewed =
+				before.outcome === "review"
+					? await input.review?.({
+							requestId: input.requestId,
+							plan,
+							analysis,
+							nativeConstraints,
+							authorization: initialAuthorization,
+							startedAt,
+							signal: queueSignal,
+						})
+					: undefined;
+			if (queueSignal.aborted) throw new Error("PERMISSION_REQUEST_INVALID");
+			const automaticReview =
+				reviewed?.remoteState === "valid"
+					? reviewed.remote
+					: reviewed?.primaryState === "valid"
+						? reviewed.primary
+						: undefined;
+			const automaticSource = reviewed?.remoteState === "valid" ? "remote-fallback" : "reviewer";
+			const reviewBindingCurrent =
+				automaticReview !== undefined &&
+				initial.generation === ledger.generation &&
+				binding(input, plan, ledger, config, authorizationContext()).authorization_digest ===
+					initial.authorization_digest;
+			let assessment =
+				before.outcome === "review"
+					? synthesizeReview(policyInput, automaticReview, reviewBindingCurrent, automaticSource)
+					: before;
+			if (before.outcome === "review" && !automaticReview && reviewed?.fallbackState === "valid") {
+				assessment = {
+					outcome: reviewed.outcome === "deny" ? "deny" : "ask",
+					source: "fallback",
+					reason_code: reviewed.outcome === "deny" ? "MATERIAL_RISK" : "USER_CONFIRMATION_REQUIRED",
+					restrictionState: before.restrictionState,
+					modelCallsAllowed: false,
+				};
+			}
+			const decision = ledger.recordDecision(handle, assessment, {
+				health_result: assessment.outcome === "allow" ? "healthy" : host.bridge_health,
+				...(reviewed && reviewed.actualModel !== "not-called"
+					? {
+							actual_model: reviewed.actualModel,
+							model_source:
+								reviewed.modelSource === "explicit-profile"
+									? ("explicit" as const)
+									: reviewed.modelSource === "remote-fallback"
+										? ("remote-fallback" as const)
+										: reviewed.modelSource === "fallback"
+											? ("fallback" as const)
+											: ("session-default" as const),
+						}
+					: {}),
+				...(reviewed?.fallbackState === "valid"
+					? { fallback_result: reviewed.outcome === "deny" ? ("deny" as const) : ("ask" as const) }
+					: {}),
+				...(automaticReview ? { model_result: automaticReview } : {}),
+			});
+			if (decision.outcome === "deny") {
+				if (
+					!(await audit({
+						binding: initial,
+						decision,
+						review: reviewed,
+						plan,
+						analysisComplete,
+						startedAt,
+						permit: "none",
+					}))
+				)
+					ledger.invalidate("health-changed");
+				throw new Error("PERMISSION_CONTROL_DENIED");
+			}
+			let permit: ExecutionPermit;
+			let human: HumanDecision | undefined;
+			if (decision.outcome === "ask") {
+				terminal = { binding: initial, decision, review: reviewed, analysisComplete };
+				if (
+					!(await audit({
+						...terminal,
+						plan,
+						startedAt,
+						permit: "none",
+					}))
+				) {
+					ledger.invalidate("health-changed");
+					throw new Error("PERMISSION_AUDIT_UNAVAILABLE");
+				}
+				const approved = await input.ask(decision.reason_code);
+				if (queueSignal.aborted) throw new Error("PERMISSION_REQUEST_INVALID");
+				const current = binding(input, plan, ledger, config, authorizationContext());
+				human = ledger.recordHuman(handle, decision, approved ? "allow" : "deny", current);
+				if (!approved) {
+					if (
+						!(await audit({
+							binding: initial,
+							decision,
+							human,
+							review: reviewed,
+							plan,
+							analysisComplete,
+							startedAt,
+							permit: "none",
+						}))
+					)
+						ledger.invalidate("health-changed");
+					throw new Error("PERMISSION_CONTROL_DENIED_BY_USER");
+				}
+				permit = ledger.createPermit(handle, decision, human);
+			} else permit = ledger.createPermit(handle, decision);
+			terminal = { binding: initial, decision, human, review: reviewed, analysisComplete };
+			if (!(await audit({ ...terminal, plan, startedAt, permit: "pending" }))) {
+				ledger.invalidate("health-changed");
+				throw new Error("PERMISSION_AUDIT_UNAVAILABLE");
+			}
+			preflightRecorded = true;
+			if (queueSignal.aborted) throw new Error("PERMISSION_REQUEST_INVALID");
+			if (plan.coverage_state !== "eligible") {
+				const current = binding(input, plan, ledger, config, authorizationContext());
+				const completion = ledger.consume(permit, current, () => {
+					consumed = true;
+					return input.manualStart();
+				});
+				queueTerminalAudit("consumed");
+				return { completion };
+			}
+			const staged = await input.stage(queueSignal);
+			const completion = input.start(staged, () => {
+				const current = binding(input, plan, ledger, config, authorizationContext());
+				ledger.consume(permit, current, () => {
+					consumed = true;
+				});
+			});
+			if (consumed) {
+				queueTerminalAudit("consumed");
+				return { completion };
+			}
+			return {
+				completion: Promise.resolve(completion).then(
+					value => {
+						queueTerminalAudit(consumed ? "consumed" : "invalidated");
+						if (!consumed) throw new Error("PERMISSION_START_WITHOUT_CONSUME");
+						return value;
+					},
+					error => {
+						queueTerminalAudit(consumed ? "consumed" : "invalidated");
+						throw error;
+					},
+				),
+			};
+		} catch (error) {
+			if (!consumed && terminal && preflightRecorded) {
+				void (async () => {
+					try {
+						const ok = input.audit
+							? await input.audit({ ...terminal, plan, startedAt, permit: "invalidated" })
+							: true;
+						if (!ok) ledger.invalidate("health-changed");
+					} catch {
+						try {
+							ledger.invalidate("health-changed");
+						} catch {}
+					}
+				})();
+			}
+			input.cancel();
+			throw error;
+		}
+	}, input.signal);
+}
