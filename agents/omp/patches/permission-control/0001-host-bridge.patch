index 0000000..ef9331e
--- /dev/null
+++ b/packages/coding-agent/src/permission-control/read-proof.ts
@@ -0,0 +1,412 @@
+import { createHash } from "node:crypto";
+import { lstatSync, opendirSync } from "node:fs";
+import { isAbsolute, join, parse, relative, resolve, sep } from "node:path";
+import {
+	inspectReadCommands,
+	type ExecutableEvidence,
+	type ShellAnalysisContext,
+	type TargetEvidence,
+} from "./core/shell-analysis";
+
+const HEX_64 = /^[0-9a-f]{64}$/u;
+const MAX_COMMAND_BYTES = 16 * 1024;
+const MAX_ENTRIES = 4096;
+const MAX_DEPTH = 32;
+const MAX_TOTAL_BYTES = 256 * 1024 * 1024;
+const MAX_SCAN_MILLISECONDS = 250;
+const UTILITY_BUILTINS = new Set(["ls", "head", "wc", "rg"]);
+
+// shell.rs registers these utility builtins ahead of PATH resolution when the
+// host proves PI_DISABLE_UUTILS_BUILTINS is inactive. pwd is a Brush builtin.
+
+export interface PermissionReadContextInput {
+	command: string;
+	cwd: string;
+	shellIdentity: string;
+	continuityFingerprint: string;
+	targetFingerprint: string;
+	utilityBuiltinsEnabled: boolean;
+}
+
+type StatRecord = {
+	path: string;
+	dev: string;
+	ino: string;
+	mode: string;
+	size: string;
+	mtimeNs: string;
+	ctimeNs: string;
+	uid: string;
+	gid: string;
+	type: "file" | "directory";
+};
+
+type AncestorRecord = Pick<StatRecord, "path" | "dev" | "ino" | "mode" | "uid" | "gid" | "type">;
+
+type ScanMode = "self" | "children" | "recursive";
+type ScanBudget = { operations: number; bytes: bigint; startedAt: number };
+type TargetRequest = { input: string; mode: ScanMode; fileOnly: boolean };
+
+function digest(value: string): string {
+	return createHash("sha256").update(value, "utf8").digest("hex");
+}
+
+function canonical(value: unknown): string {
+	if (value === null || typeof value !== "object") return JSON.stringify(value);
+	if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+	const record = value as Record<string, unknown>;
+	return `{${Object.keys(record)
+		.sort((left, right) => Buffer.compare(Buffer.from(left), Buffer.from(right)))
+		.filter(key => record[key] !== undefined)
+		.map(key => `${JSON.stringify(key)}:${canonical(record[key])}`)
+		.join(",")}}`;
+}
+
+export function digestPermissionReadContext(context: ShellAnalysisContext): string {
+	return digest(canonical(context));
+}
+
+function validDigest(value: string): boolean {
+	return value.length === 64 && HEX_64.test(value);
+}
+
+function hasControl(value: string): boolean {
+	for (const character of value) {
+		const code = character.charCodeAt(0);
+		if (code <= 0x1f || (code >= 0x7f && code <= 0x9f)) return true;
+	}
+	return false;
+}
+
+function isSecretComponent(value: string): boolean {
+	const lower = value.toLowerCase();
+	return (
+		lower === ".ssh" ||
+		lower === ".aws" ||
+		lower === ".gnupg" ||
+		lower === ".git" ||
+		lower === ".codex" ||
+		lower === ".pi" ||
+		lower === "auth.json" ||
+		lower === "id_rsa" ||
+		lower === "id_ed25519" ||
+		/(?:^|[._-])credentials?(?:[._-]|$)/u.test(lower) ||
+		/(?:^|[._-])secrets?(?:[._-]|$)/u.test(lower) ||
+		lower.endsWith(".pem") ||
+		lower.endsWith(".key") ||
+		lower === ".env" ||
+		lower.startsWith(".env.")
+	);
+}
+
+function consumeBudget(budget: ScanBudget, size = 0n): boolean {
+	budget.operations++;
+	budget.bytes += size;
+	return (
+		budget.operations <= MAX_ENTRIES &&
+		budget.bytes <= BigInt(MAX_TOTAL_BYTES) &&
+		performance.now() - budget.startedAt <= MAX_SCAN_MILLISECONDS
+	);
+}
+
+function statRecord(
+	path: string,
+	displayPath: string,
+	budget: ScanBudget,
+	countBytes: boolean,
+): StatRecord | undefined {
+	if (!consumeBudget(budget)) return undefined;
+	const stat = lstatSync(path, { bigint: true });
+	if (stat.isSymbolicLink()) return undefined;
+	const type = stat.isFile() ? "file" : stat.isDirectory() ? "directory" : undefined;
+	if (!type) return undefined;
+	if (countBytes && !consumeBudget(budget, stat.size)) return undefined;
+	return {
+		path: displayPath,
+		dev: stat.dev.toString(),
+		ino: stat.ino.toString(),
+		mode: stat.mode.toString(),
+		size: stat.size.toString(),
+		mtimeNs: stat.mtimeNs.toString(),
+		ctimeNs: stat.ctimeNs.toString(),
+		uid: stat.uid.toString(),
+		gid: stat.gid.toString(),
+		type,
+	};
+}
+
+function pathComponents(absolute: string): string[] {
+	const root = parse(absolute).root;
+	const rest = absolute.slice(root.length).split(sep).filter(Boolean);
+	return [root, ...rest];
+}
+
+function pathBinding(absolute: string, budget: ScanBudget): AncestorRecord[] | undefined {
+	const records: AncestorRecord[] = [];
+	let current = parse(absolute).root;
+	const rootRecord = statRecord(current, ".", budget, false);
+	if (!rootRecord) return undefined;
+	records.push(ancestorRecord(rootRecord));
+	for (const component of pathComponents(absolute).slice(1)) {
+		if (hasControl(component) || isSecretComponent(component)) return undefined;
+		current = join(current, component);
+		const record = statRecord(current, relative(parse(absolute).root, current), budget, false);
+		if (!record) return undefined;
+		records.push(ancestorRecord(record));
+	}
+	return records;
+}
+
+function ancestorRecord(record: StatRecord): AncestorRecord {
+	return {
+		path: record.path,
+		dev: record.dev,
+		ino: record.ino,
+		mode: record.mode,
+		uid: record.uid,
+		gid: record.gid,
+		type: record.type,
+	};
+}
+
+function sortedNames(path: string, budget: ScanBudget): string[] | undefined {
+	// The accepted ls argv never includes -a/-A, so hidden entries are not in
+	// the builtin's observable read set and do not need to broaden the proof.
+	if (!consumeBudget(budget)) return undefined;
+	const directory = opendirSync(path);
+	const names: string[] = [];
+	try {
+		for (;;) {
+			if (!consumeBudget(budget)) return undefined;
+			const entry = directory.readSync();
+			if (!entry) break;
+			if (!entry.name.startsWith(".")) names.push(entry.name);
+		}
+	} finally {
+		directory.closeSync();
+	}
+	if (names.some(name => hasControl(name) || isSecretComponent(name))) return undefined;
+	return names.sort((left, right) => Buffer.compare(Buffer.from(left), Buffer.from(right)));
+}
+
+function scanTree(
+	root: string,
+	current: string,
+	depth: number,
+	recursive: boolean,
+	budget: ScanBudget,
+	records: StatRecord[],
+): boolean {
+	if (depth > MAX_DEPTH) return false;
+	const names = sortedNames(current, budget);
+	if (!names) return false;
+	for (const name of names) {
+		const path = join(current, name);
+		const record = statRecord(path, relative(root, path), budget, true);
+		if (!record) return false;
+		records.push(record);
+		if (recursive && record.type === "directory") {
+			if (!scanTree(root, path, depth + 1, true, budget, records)) return false;
+		}
+	}
+	return true;
+}
+
+function lexicalTarget(input: string, cwd: string): string | undefined {
+	if (input === "cwd" || input === ".") return cwd;
+	if (input.length === 0 || isAbsolute(input) || hasControl(input)) return undefined;
+	const components = input.split(/[\\/]/u);
+	if (components.some(part => !part || part === "." || part === ".." || isSecretComponent(part))) return undefined;
+	const absolute = resolve(cwd, input);
+	const within = relative(cwd, absolute);
+	if (!within || within === ".." || within.startsWith(`..${sep}`) || isAbsolute(within)) return undefined;
+	return absolute;
+}
+
+function scanTarget(
+	request: TargetRequest,
+	cwd: string,
+	targetFingerprint: string,
+	budget: ScanBudget,
+): TargetEvidence | undefined {
+	const absolute = lexicalTarget(request.input, cwd);
+	if (!absolute) return undefined;
+	const ancestors = pathBinding(absolute, budget);
+	if (!ancestors) return undefined;
+	const target = statRecord(absolute, request.input, budget, true);
+	if (!target || (request.fileOnly && target.type !== "file")) return undefined;
+	const records: StatRecord[] = [target];
+	if (target.type === "directory" && request.mode !== "self") {
+		if (!scanTree(absolute, absolute, 1, request.mode === "recursive", budget, records)) return undefined;
+	}
+	const scope = digest(canonical({ targetFingerprint, ancestors, records }));
+	return {
+		input: request.input,
+		canonical: absolute,
+		fingerprint: scope,
+		category: "bounded-read",
+		targetType: request.input === "cwd" ? "cwd" : target.type,
+		normalized: true,
+		nonSecret: true,
+		nonDevice: true,
+		verified: true,
+		...(request.mode === "recursive" ? { recursiveReadVerified: true, recursiveReadScopeFingerprint: scope } : {}),
+	};
+}
+
+function stronger(left: ScanMode, right: ScanMode): ScanMode {
+	const rank: Record<ScanMode, number> = { self: 0, children: 1, recursive: 2 };
+	return rank[left] >= rank[right] ? left : right;
+}
+
+function addRequest(requests: Map<string, TargetRequest>, request: TargetRequest): void {
+	const current = requests.get(request.input);
+	requests.set(
+		request.input,
+		current
+			? {
+					input: request.input,
+					mode: stronger(current.mode, request.mode),
+					fileOnly: current.fileOnly || request.fileOnly,
+				}
+			: request,
+	);
+}
+
+function executableEvidence(
+	name: string,
+	shellIdentity: string,
+	continuityFingerprint: string,
+	utilityBuiltinsEnabled: boolean,
+): ExecutableEvidence {
+	const builtin = name === "pwd" ? "brush:pwd" : `pi-builtins:${name}`;
+	return {
+		argv0: name,
+		resolvedPath: `builtin:${builtin}`,
+		identityDigest: digest(canonical({ builtin, shellIdentity })),
+		source: "builtin",
+		noRelevantShadowing: true,
+		resolutionFingerprint: digest(
+			canonical({ builtin, continuityFingerprint, shellIdentity, utilityBuiltinsEnabled }),
+		),
+		verified: true,
+	};
+}
+
+function sameProof(left: TargetEvidence, right: TargetEvidence): boolean {
+	return canonical(left) === canonical(right);
+}
+
+export function buildPermissionReadContext(input: PermissionReadContextInput): ShellAnalysisContext | undefined {
+	try {
+		const budget: ScanBudget = { operations: 0, bytes: 0n, startedAt: performance.now() };
+		if (
+			typeof input.command !== "string" ||
+			Buffer.byteLength(input.command, "utf8") > MAX_COMMAND_BYTES ||
+			typeof input.cwd !== "string" ||
+			!isAbsolute(input.cwd) ||
+			hasControl(input.cwd) ||
+			!validDigest(input.shellIdentity) ||
+			!validDigest(input.continuityFingerprint) ||
+			!validDigest(input.targetFingerprint) ||
+			typeof input.utilityBuiltinsEnabled !== "boolean"
+		)
+			return undefined;
+		const cwd = resolve(input.cwd);
+		const cwdStat = statRecord(cwd, "cwd", budget, false);
+		if (!cwdStat || cwdStat.type !== "directory" || !pathBinding(cwd, budget)) return undefined;
+		const commands = inspectReadCommands(input.command);
+		if (!commands || commands.length === 0) return undefined;
+		const names = new Set<string>();
+		const requests = new Map<string, TargetRequest>();
+		addRequest(requests, { input: "cwd", mode: "self", fileOnly: false });
+		for (const command of commands) {
+			const name = command.argv[0];
+			if (command.hasInputRedirection) return undefined;
+			if (command.argv.slice(1).includes("cwd")) return undefined;
+			if (name === "git" || (name !== "pwd" && !UTILITY_BUILTINS.has(name))) return undefined;
+			if (UTILITY_BUILTINS.has(name) && !input.utilityBuiltinsEnabled) return undefined;
+			names.add(name);
+			if (name === "head" || name === "wc") {
+				if (command.targets.length === 0 && command.connector !== "|") return undefined;
+				for (const target of command.targets) addRequest(requests, { input: target, mode: "self", fileOnly: true });
+				continue;
+			}
+			if (name === "rg") {
+				const readsPipeline =
+					command.connector === "|" && command.targets.length === 1 && command.targets[0] === "cwd";
+				if (!readsPipeline)
+					for (const target of command.targets)
+						addRequest(requests, { input: target, mode: "self", fileOnly: true });
+				continue;
+			}
+			if (name === "ls") {
+				const flags: string[] = [];
+				let sawOperand = false;
+				for (const argument of command.argv.slice(1)) {
+					if (argument === "--") break;
+					if (argument.startsWith("-")) {
+						// 位置参数之后的选项在各实现间有歧义，不能减少目标读取证明。
+						if (sawOperand) return undefined;
+						flags.push(argument);
+					} else sawOperand = true;
+				}
+				const recursive = flags.some(argument => /^-[^-]*R/u.test(argument));
+				if (flags.some(argument => /^-[^-]*a/u.test(argument))) return undefined;
+				const long = flags.some(argument => /^-[^-]*l/u.test(argument));
+				const numeric = flags.some(argument => /^-[^-]*n/u.test(argument));
+				if (long && !numeric) return undefined;
+				const directoryOnly = flags.some(argument => /^-[^-]*d/u.test(argument));
+				if (directoryOnly && recursive) return undefined;
+				for (const target of command.targets)
+					addRequest(requests, {
+						input: target,
+						mode: directoryOnly ? "self" : recursive ? "recursive" : "children",
+						fileOnly: false,
+					});
+			}
+		}
+		const targets: Record<string, TargetEvidence> = {};
+		for (const request of requests.values()) {
+			const first = scanTarget(request, cwd, input.targetFingerprint, budget);
+			const second = scanTarget(request, cwd, input.targetFingerprint, budget);
+			if (!first || !second || !sameProof(first, second)) return undefined;
+			targets[request.input] = first;
+		}
+		const executables: Record<string, ExecutableEvidence> = {};
+		for (const name of names)
+			executables[name] = executableEvidence(
+				name,
+				input.shellIdentity,
+				input.continuityFingerprint,
+				input.utilityBuiltinsEnabled,
+			);
+		return {
+			cwd: {
+				path: cwd,
+				category: "unknown",
+				fingerprint: digest(canonical({ cwd: targets.cwd.fingerprint, target: input.targetFingerprint })),
+				verified: true,
+			},
+			shellState: {
+				fingerprint: digest(
+					canonical({
+						command: input.command,
+						continuity: input.continuityFingerprint,
+						shell: input.shellIdentity,
+						target: input.targetFingerprint,
+						utilityBuiltinsEnabled: input.utilityBuiltinsEnabled,
+					}),
+				),
+				verified: true,
+				trapsDisabled: true,
+				optionsSafe: true,
+				implicitCommandsAbsent: true,
+			},
+			executables,
+			targets,
+		};
+	} catch {
+		return undefined;
+	}
+}
