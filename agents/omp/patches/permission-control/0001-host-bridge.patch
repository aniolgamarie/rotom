index 0000000..73044da
--- /dev/null
+++ b/packages/coding-agent/src/permission-control/host.ts
@@ -0,0 +1,146 @@
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type {
+	Extension,
+	PermissionControllerRegistration,
+	RegisteredPermissionController,
+} from "../extensibility/extensions/types";
+import type { NativePermissionControl } from "./core/types";
+
+export type HostPermissionRegistration = RegisteredPermissionController;
+
+/** Store a candidate with loader-owned provenance; extensions cannot supply resolvedPath. */
+export function registerPermissionControllerCandidate(
+	extension: Extension,
+	registration: PermissionControllerRegistration,
+	resolvedPath: string,
+): void {
+	if (
+		Object.keys(registration).length !== 4 ||
+		!Object.keys(registration).every(key => ["pluginId", "bridgeAbi", "review", "command"].includes(key)) ||
+		registration?.pluginId !== "omp-permission-control" ||
+		registration.bridgeAbi !== "permission-control/v1" ||
+		typeof registration.review !== "function" ||
+		typeof registration.command !== "function" ||
+		(extension.permissionControllers?.length ?? 0) !== 0
+	)
+		throw new Error("PERMISSION_CONTROLLER_REGISTRATION_INVALID");
+	extension.permissionControllers ??= [];
+	extension.permissionControllers.push(Object.freeze({ ...registration, resolvedPath }));
+}
+
+function canonical(value: unknown): string {
+	if (value === null || typeof value === "string" || typeof value === "boolean") return JSON.stringify(value);
+	if (typeof value === "number" && Number.isFinite(value)) return JSON.stringify(value);
+	if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+	if (value && typeof value === "object")
+		return `{${Object.keys(value)
+			.sort()
+			.map(key => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`)
+			.join(",")}}`;
+	throw new Error("PERMISSION_CONTROLLER_IDENTITY_INVALID");
+}
+
+function sha256(value: string | Uint8Array): string {
+	return new Bun.CryptoHasher("sha256").update(value).digest("hex");
+}
+
+function owned(stat: fs.Stats): boolean {
+	return typeof process.geteuid !== "function" || stat.uid === process.geteuid();
+}
+
+function pluginTreeDigest(root: string): string {
+	const entries: Array<{ path: string; target: string; sha256: string; executable: boolean }> = [];
+	const visit = (directory: string): void => {
+		const directoryStat = fs.lstatSync(directory);
+		if (!directoryStat.isDirectory() || directoryStat.isSymbolicLink() || !owned(directoryStat))
+			throw new Error("PERMISSION_CONTROLLER_IDENTITY_INVALID");
+		for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+			const absolute = path.join(directory, entry.name);
+			const stat = fs.lstatSync(absolute);
+			if (stat.isSymbolicLink()) throw new Error("PERMISSION_CONTROLLER_IDENTITY_INVALID");
+			if (stat.isDirectory()) {
+				visit(absolute);
+				continue;
+			}
+			if (!stat.isFile() || stat.nlink !== 1 || !owned(stat))
+				throw new Error("PERMISSION_CONTROLLER_IDENTITY_INVALID");
+			const relative = path.relative(root, absolute).split(path.sep).join("/");
+			entries.push({
+				path: `agents/omp/packages/omp-permission-control/${relative}`,
+				target: `packages/omp-permission-control/${relative}`,
+				sha256: sha256(fs.readFileSync(absolute)),
+				executable: Boolean(stat.mode & 0o111),
+			});
+		}
+	};
+	visit(root);
+	entries.sort((left, right) => Buffer.compare(Buffer.from(left.path), Buffer.from(right.path)));
+	return sha256(`${canonical(entries)}\n`);
+}
+
+/** Resolve exactly one registered controller and bind it to installed bytes and receipt identity. */
+export function resolvePermissionController(
+	extensions: readonly Extension[],
+	config: Readonly<NativePermissionControl>,
+): HostPermissionRegistration | undefined {
+	const candidates = extensions.flatMap(extension => extension.permissionControllers ?? []);
+	if (candidates.length !== 1) return undefined;
+	const candidate = candidates[0];
+	try {
+		if (!path.isAbsolute(candidate.resolvedPath)) return undefined;
+		const unresolvedEntry = path.normalize(candidate.resolvedPath);
+		const unresolvedRoot = path.dirname(unresolvedEntry);
+		const unresolvedPackages = path.dirname(unresolvedRoot);
+		const unresolvedRuntime = path.dirname(unresolvedPackages);
+		for (const [item, kind] of [
+			[unresolvedEntry, "file"],
+			[unresolvedRoot, "directory"],
+			[unresolvedPackages, "directory"],
+			[unresolvedRuntime, "directory"],
+		] as const) {
+			const stat = fs.lstatSync(item);
+			if (
+				stat.isSymbolicLink() ||
+				!owned(stat) ||
+				(kind === "file" ? !stat.isFile() || stat.nlink !== 1 : !stat.isDirectory())
+			)
+				return undefined;
+		}
+		const entry = fs.realpathSync(candidate.resolvedPath);
+		const pluginRoot = fs.realpathSync(path.dirname(entry));
+		if (
+			entry !== unresolvedEntry ||
+			pluginRoot !== unresolvedRoot ||
+			entry !== path.join(pluginRoot, "index.ts") ||
+			path.basename(pluginRoot) !== "omp-permission-control" ||
+			path.basename(unresolvedPackages) !== "packages"
+		)
+			return undefined;
+		const runtimeRoot = path.dirname(path.dirname(pluginRoot));
+		const receiptPath = path.join(runtimeRoot, ".agentcfg-receipt.json");
+		const receiptStat = fs.lstatSync(receiptPath);
+		if (
+			!receiptStat.isFile() ||
+			receiptStat.isSymbolicLink() ||
+			receiptStat.nlink !== 1 ||
+			!owned(receiptStat) ||
+			receiptStat.size > 64 * 1024
+		)
+			return undefined;
+		const receipt = JSON.parse(fs.readFileSync(receiptPath, "utf8")) as Record<string, unknown>;
+		if (
+			candidate.pluginId !== config.pluginId ||
+			candidate.bridgeAbi !== config.bridgeAbi ||
