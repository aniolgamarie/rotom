index 0000000..68a59cc
--- /dev/null
+++ b/packages/coding-agent/src/permission-control/bridge.ts
@@ -0,0 +1,465 @@
+export const BRIDGE_ABI = "permission-control/v1" as const;
+
+export type PermissionControlCoverageReason =
+	| "direnv"
+	| "devenv"
+	| "prefix"
+	| "service"
+	| "async"
+	| "pty"
+	| "acp-terminal"
+	| "use-user-shell"
+	| "startup-script"
+	| "bash-env"
+	| "exported-function"
+	| "internal-url"
+	| "worktree-rewrite"
+	| "interceptor"
+	| "auto-background"
+	| "persistent-shell-state"
+	| "non-native-backend";
+
+export type PermissionControlTransformation = "effective-params" | "leading-cd" | "worktree-rewrite" | "internal-url";
+
+export interface PermissionControlExecutionSnapshot<TArgs> {
+	opaquePlanId: string;
+	finalCommand: Uint8Array;
+	finalArgs: TArgs;
+	cwd: string;
+	shell: { path: string; args: readonly string[] };
+	environmentDigest: string;
+	backend: string;
+	targetFingerprint: string;
+	transformations: readonly PermissionControlTransformation[];
+	coverageReasons: readonly PermissionControlCoverageReason[];
+	analysisContext?: import("./core/shell-analysis").ShellAnalysisContext;
+}
+
+export interface PermissionControlExecutionAdapter<TArgs, TResult> {
+	prepare(request: Readonly<PrepareBashExecutionRequest<TArgs>>): PermissionControlExecutionSnapshot<TArgs>;
+	revalidate(snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>): boolean;
+	commit(snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>): Promise<TResult>;
+	stage?(snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>, signal?: AbortSignal): Promise<unknown>;
+	start?(
+		snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>,
+		staged: unknown,
+		onBeforeStart: () => void,
+	): Promise<TResult>;
+	cancelStage?(staged: unknown): void;
+	invalidate?(snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>): void;
+}
+
+export interface PrepareBashExecutionRequest<TArgs> {
+	requestId: string;
+	sessionId: string;
+	generation: number;
+	args: TArgs;
+	signal?: AbortSignal;
+	toolNames?: readonly string[];
+	onUpdate?: unknown;
+}
+
+export interface PreparedBashExecution {
+	readonly prepared_execution_id: Readonly<{ kind: "permission-control-prepared-execution" }>;
+	readonly final_command: Readonly<Uint8Array>;
+	readonly transformation_summary: Readonly<{
+		version: 1;
+		transformations: readonly PermissionControlTransformation[];
+	}>;
+	readonly execution_binding: Readonly<{
+		digest: string;
+		local_ref: Readonly<{ kind: "permission-control-execution-binding" }>;
+	}>;
+	readonly coverage_state: "eligible" | "manual-required";
+	readonly coverage_reasons: readonly PermissionControlCoverageReason[];
+	readonly final_args: Readonly<Record<string, unknown>>;
+	readonly execution_context: Readonly<{
+		cwd: string;
+		shell: Readonly<{ path: string; args: readonly string[] }>;
+		environmentDigest: string;
+		backend: string;
+		targetFingerprint: string;
+	}>;
+	readonly analysis_context?: import("./core/shell-analysis").ShellAnalysisContext;
+}
+
+export interface CommitPreparedBashExecutionContext {
+	requestId: string;
+	sessionId: string;
+	generation: number;
+	executionBinding: string;
+	signal?: AbortSignal;
+}
+
+export type PermissionControlBridgeErrorCode =
+	| "PREPARE_CANCELLED"
+	| "INVALID_SNAPSHOT"
+	| "PLAN_UNKNOWN"
+	| "PLAN_ADAPTER_MISMATCH"
+	| "PLAN_ALREADY_CONSUMED"
+	| "PLAN_INVALIDATED"
+	| "PLAN_MANUAL_REQUIRED"
+	| "PLAN_CANCELLED"
+	| "PLAN_CONTEXT_CHANGED"
+	| "PLAN_REVALIDATION_FAILED";
+
+export interface StagedBashExecution {
+	readonly staged_execution_id: Readonly<{ kind: "permission-control-staged-execution" }>;
+}
+
+export class PermissionControlBridgeError extends Error {
+	readonly code: PermissionControlBridgeErrorCode;
+
+	constructor(code: PermissionControlBridgeErrorCode) {
+		super(code);
+		this.name = "PermissionControlBridgeError";
+		this.code = code;
+	}
+}
+
+interface PlanRecord<TArgs, TResult> {
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>;
+	requestId: string;
+	sessionId: string;
+	generation: number;
+	bindingDigest: string;
+	snapshot: Readonly<PermissionControlExecutionSnapshot<TArgs>>;
+	prepareSignal?: AbortSignal;
+	state: "pending" | "consumed" | "invalidated";
+}
+
+const planRecords = new WeakMap<object, PlanRecord<unknown, unknown>>();
+interface StageRecord {
+	plan: PreparedBashExecution;
+	value: unknown;
+	state: "staged" | "started" | "cancelled";
+}
+const stageRecords = new WeakMap<StagedBashExecution, StageRecord>();
+const coverageReasons = new Set<PermissionControlCoverageReason>([
+	"direnv",
+	"devenv",
+	"prefix",
+	"service",
+	"async",
+	"pty",
+	"acp-terminal",
+	"use-user-shell",
+	"startup-script",
+	"bash-env",
+	"exported-function",
+	"internal-url",
+	"worktree-rewrite",
+	"interceptor",
+	"auto-background",
+	"persistent-shell-state",
+	"non-native-backend",
+]);
+const transformations = new Set<PermissionControlTransformation>([
+	"effective-params",
+	"leading-cd",
+	"worktree-rewrite",
+	"internal-url",
+]);
+
+function fail(code: PermissionControlBridgeErrorCode): never {
+	throw new PermissionControlBridgeError(code);
+}
+
+function stableValue(value: unknown, seen = new Set<object>()): unknown {
+	if (value === null || typeof value === "string" || typeof value === "boolean") return value;
+	if (typeof value === "number") return Number.isFinite(value) ? value : fail("INVALID_SNAPSHOT");
+	if (Array.isArray(value)) return value.map(item => stableValue(item, seen));
+	if (typeof value !== "object") return fail("INVALID_SNAPSHOT");
+	if (seen.has(value)) return fail("INVALID_SNAPSHOT");
+	seen.add(value);
+	const result: Record<string, unknown> = {};
+	for (const key of Object.keys(value).sort())
+		result[key] = stableValue((value as Record<string, unknown>)[key], seen);
+	seen.delete(value);
+	return result;
+}
+
+function digest(value: unknown): string {
+	return new Bun.CryptoHasher("sha256").update(JSON.stringify(stableValue(value))).digest("hex");
+}
+
+function cloneAndFreeze<T>(value: T): T {
+	const cloned = structuredClone(value);
+	const freeze = (item: unknown): void => {
+		if (item === null || typeof item !== "object" || ArrayBuffer.isView(item)) return;
+		for (const child of Object.values(item)) freeze(child);
+		Object.freeze(item);
+	};
+	freeze(cloned);
+	return cloned;
+}
+
+function validateSnapshot<TArgs>(snapshot: PermissionControlExecutionSnapshot<TArgs>): void {
+	if (!/^[0-9a-f]{64}$/u.test(snapshot.opaquePlanId) || snapshot.opaquePlanId.length !== 64) fail("INVALID_SNAPSHOT");
+	if (!(snapshot.finalCommand instanceof Uint8Array) || snapshot.finalCommand.byteLength === 0)
+		fail("INVALID_SNAPSHOT");
+	if (!snapshot.cwd || /[\u0000\r\n]/u.test(snapshot.cwd)) fail("INVALID_SNAPSHOT");
+	if (!snapshot.shell?.path || /[\u0000\r\n]/u.test(snapshot.shell.path)) fail("INVALID_SNAPSHOT");
+	if (!snapshot.backend || !snapshot.environmentDigest || !snapshot.targetFingerprint) fail("INVALID_SNAPSHOT");
+	if (new Set(snapshot.coverageReasons).size !== snapshot.coverageReasons.length) fail("INVALID_SNAPSHOT");
+	if (new Set(snapshot.transformations).size !== snapshot.transformations.length) fail("INVALID_SNAPSHOT");
+	if (!snapshot.coverageReasons.every(reason => coverageReasons.has(reason))) fail("INVALID_SNAPSHOT");
+	if (!snapshot.transformations.every(transformation => transformations.has(transformation))) fail("INVALID_SNAPSHOT");
+	if (snapshot.backend !== "native" && !snapshot.coverageReasons.includes("non-native-backend")) {
+		fail("INVALID_SNAPSHOT");
+	}
+}
+
+export function prepareBashExecution<TArgs, TResult>(
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>,
+	request: Readonly<PrepareBashExecutionRequest<TArgs>>,
+): PreparedBashExecution {
+	if (request.signal?.aborted) fail("PREPARE_CANCELLED");
+	const rawSnapshot = adapter.prepare(request);
+	validateSnapshot(rawSnapshot);
+	if (request.signal?.aborted) fail("PREPARE_CANCELLED");
+
+	const commandBytes = new Uint8Array(rawSnapshot.finalCommand);
+	const snapshot = cloneAndFreeze({
+		...rawSnapshot,
+		finalCommand: commandBytes,
+		finalArgs: rawSnapshot.finalArgs,
+		shell: { path: rawSnapshot.shell.path, args: [...rawSnapshot.shell.args] },
+		transformations: [...rawSnapshot.transformations],
+		coverageReasons: [...rawSnapshot.coverageReasons],
+	});
+	const bindingDigest = digest({
+		requestId: request.requestId,
+		sessionId: request.sessionId,
+		generation: request.generation,
+		opaquePlanId: snapshot.opaquePlanId,
+		finalCommand: [...commandBytes],
+		finalArgs: snapshot.finalArgs,
+		cwd: snapshot.cwd,
+		shell: snapshot.shell,
+		environmentDigest: snapshot.environmentDigest,
+		backend: snapshot.backend,
+		targetFingerprint: snapshot.targetFingerprint,
+		transformations: snapshot.transformations,
+		coverageReasons: snapshot.coverageReasons,
+		...(snapshot.analysisContext ? { analysisContext: snapshot.analysisContext } : {}),
+		algorithmVersion: 1,
+	});
+	const preparedId = Object.freeze({ kind: "permission-control-prepared-execution" as const });
+	const localRef = Object.freeze({ kind: "permission-control-execution-binding" as const });
+	const transformations = Object.freeze([...snapshot.transformations]);
+	const reasons = Object.freeze([...snapshot.coverageReasons]);
+	const plan = Object.freeze({
+		prepared_execution_id: preparedId,
+		get final_command(): Readonly<Uint8Array> {
+			return new Uint8Array(commandBytes);
+		},
+		transformation_summary: Object.freeze({ version: 1 as const, transformations }),
+		execution_binding: Object.freeze({ digest: bindingDigest, local_ref: localRef }),
+		coverage_state: reasons.length === 0 ? ("eligible" as const) : ("manual-required" as const),
+		coverage_reasons: reasons,
+		final_args: snapshot.finalArgs as Readonly<Record<string, unknown>>,
+		execution_context: Object.freeze({
+			cwd: snapshot.cwd,
+			shell: Object.freeze({ path: snapshot.shell.path, args: Object.freeze([...snapshot.shell.args]) }),
+			environmentDigest: snapshot.environmentDigest,
+			backend: snapshot.backend,
+			targetFingerprint: snapshot.targetFingerprint,
+		}),
+		...(snapshot.analysisContext ? { analysis_context: snapshot.analysisContext } : {}),
+	});
+	planRecords.set(plan, {
+		adapter: adapter as PermissionControlExecutionAdapter<unknown, unknown>,
+		requestId: request.requestId,
+		sessionId: request.sessionId,
+		generation: request.generation,
+		bindingDigest,
+		snapshot: snapshot as PermissionControlExecutionSnapshot<unknown>,
+		prepareSignal: request.signal,
+		state: "pending",
+	});
+	return plan;
+}
+
+export function commitPreparedBashExecution<TArgs, TResult>(
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>,
+	plan: PreparedBashExecution,
+	current: Readonly<CommitPreparedBashExecutionContext>,
+): Promise<TResult> {
+	const record = planRecords.get(plan) as PlanRecord<TArgs, TResult> | undefined;
+	if (!record) fail("PLAN_UNKNOWN");
+	if (record.state === "consumed") fail("PLAN_ALREADY_CONSUMED");
+	if (record.state === "invalidated") fail("PLAN_INVALIDATED");
+	const invalidate = (): void => {
+		record.state = "invalidated";
+		try {
+			record.adapter.invalidate?.(record.snapshot);
+		} catch {
+			// Invalidation is already final; adapter cleanup cannot restore the plan.
+		}
+	};
+	if (record.adapter !== adapter) {
+		invalidate();
+		fail("PLAN_ADAPTER_MISMATCH");
+	}
+	if (plan.coverage_state !== "eligible") fail("PLAN_MANUAL_REQUIRED");
+	if (record.prepareSignal?.aborted || current.signal?.aborted) {
+		invalidate();
+		fail("PLAN_CANCELLED");
+	}
+	if (
+		current.requestId !== record.requestId ||
+		current.sessionId !== record.sessionId ||
+		current.generation !== record.generation ||
+		current.executionBinding !== record.bindingDigest
+	) {
+		invalidate();
+		fail("PLAN_CONTEXT_CHANGED");
+	}
+	let valid = false;
+	try {
+		valid = adapter.revalidate(record.snapshot);
+	} catch {
+		valid = false;
+	}
+	if (!valid) {
+		invalidate();
+		fail("PLAN_REVALIDATION_FAILED");
+	}
+
+	// Consumption and backend invocation are deliberately synchronous. The returned
+	// promise represents backend completion; no await or mutable hook occurs here.
+	record.state = "consumed";
+	return adapter.commit(record.snapshot);
+}
+
+export function cancelPreparedBashExecution<TArgs, TResult>(
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>,
+	plan: PreparedBashExecution,
+): void {
+	const record = planRecords.get(plan) as PlanRecord<TArgs, TResult> | undefined;
+	if (!record || record.adapter !== adapter || record.state !== "pending") return;
+	record.state = "invalidated";
+	try {
+		record.adapter.invalidate?.(record.snapshot);
+	} catch {
+		// Cancellation is final even when adapter cleanup fails.
+	}
+}
+
+export async function stagePreparedBashExecution<TArgs, TResult>(
+	adapter: PermissionControlExecutionAdapter<TArgs, TResult>,
+	plan: PreparedBashExecution,
+	current: Readonly<CommitPreparedBashExecutionContext>,
