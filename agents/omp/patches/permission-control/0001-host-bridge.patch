+	let reviewer: PermissionControlSettings["reviewer"];
+	if (root.reviewer === "session") {
+		reviewer = "session";
+	} else {
+		const object = permissionObject(root.reviewer, "permissionControl.reviewer");
+		permissionFields(object, "permissionControl.reviewer", ["provider", "model"]);
+		reviewer = {
+			provider: permissionString(object.provider, "permissionControl.reviewer.provider"),
+			model: permissionString(object.model, "permissionControl.reviewer.model"),
+		};
+	}
+
+	let fallback: PermissionControlSettings["fallback"];
+	let remoteFallback: PermissionControlSettings["remoteFallback"];
+	if (Object.hasOwn(root, "remoteFallback")) {
+		const object = permissionObject(root.remoteFallback, "permissionControl.remoteFallback");
+		permissionFields(object, "permissionControl.remoteFallback", ["provider", "model"]);
+		remoteFallback = {
+			provider: permissionString(object.provider, "permissionControl.remoteFallback.provider"),
+			model: permissionString(object.model, "permissionControl.remoteFallback.model"),
+		};
+	}
