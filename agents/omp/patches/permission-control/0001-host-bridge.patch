+		current.cwd === plan.cwd &&
+		current.environmentDigest === plan.environmentDigest &&
+		current.targetFingerprint === plan.targetFingerprint &&
+		current.settingsFingerprint === plan.settingsFingerprint &&
+		current.direnvSearchChainFingerprint === plan.direnvSearchChainFingerprint &&
+		current.continuityFingerprint === plan.continuityFingerprint &&
+		current.utilityBuiltinsEnabled === plan.utilityBuiltinsEnabled &&
+		current.sessionKey === plan.sessionKey &&
+		current.generation === plan.generation &&
+		current.existingShell === plan.existingShell &&
