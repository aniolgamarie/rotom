+
+function permissionDigest(value: unknown, path: string): string {
+	if (typeof value !== "string" || value.length !== 64 || !/^[0-9a-f]{64}$/u.test(value)) {
+		return invalidPermissionControl(path, "INVALID_SHA256");
+	}
+	return value;
+}
+
+export function validatePermissionControlSetting(value: unknown): PermissionControlSettings {
+	const root = permissionObject(value, "permissionControl");
+	permissionFields(
+		root,
+		"permissionControl",
+		[
+			"schemaVersion",
+			"defaultMode",
+			"reviewer",
+			"bridgeAbi",
+			"pluginId",
+			"pluginDigest",
+			"runtimeIdentity",
+			"policyVersion",
+		],
+		["fallback", "remoteFallback"],
+	);
+	if (root.schemaVersion !== 1) invalidPermissionControl("permissionControl.schemaVersion", "INVALID_LITERAL");
+	if (root.defaultMode !== "smart" && root.defaultMode !== "manual") {
+		invalidPermissionControl("permissionControl.defaultMode", "INVALID_ENUM");
+	}
