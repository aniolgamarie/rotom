+		if (object.model !== "lfm2.5-230m")
+			invalidPermissionControl("permissionControl.fallback.model", "INVALID_LITERAL");
+		if (object.installedOnly !== true)
+			invalidPermissionControl("permissionControl.fallback.installedOnly", "INVALID_LITERAL");
+		fallback = { provider: "local", model: "lfm2.5-230m", installedOnly: true };
+	}
+	if (root.bridgeAbi !== "permission-control/v1")
+		invalidPermissionControl("permissionControl.bridgeAbi", "INVALID_LITERAL");
+	if (root.pluginId !== "omp-permission-control")
+		invalidPermissionControl("permissionControl.pluginId", "INVALID_LITERAL");
+
+	return {
+		schemaVersion: 1,
+		defaultMode: root.defaultMode,
+		reviewer,
+		...(remoteFallback ? { remoteFallback } : {}),
+		...(fallback ? { fallback } : {}),
+		bridgeAbi: "permission-control/v1",
+		pluginId: "omp-permission-control",
+		pluginDigest: permissionDigest(root.pluginDigest, "permissionControl.pluginDigest"),
+		runtimeIdentity: permissionString(root.runtimeIdentity, "permissionControl.runtimeIdentity"),
+		policyVersion: permissionDigest(root.policyVersion, "permissionControl.policyVersion"),
+	};
+}
 
