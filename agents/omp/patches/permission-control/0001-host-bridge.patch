+
+function invalidPermissionControl(path: string, reason: string): never {
+	throw new Error(`PERMISSION_CONTROL_INVALID:${path}:${reason}`);
+}
+
+function permissionObject(value: unknown, path: string): Record<string, unknown> {
+	if (value === null || typeof value !== "object" || Array.isArray(value)) {
+		return invalidPermissionControl(path, "OBJECT_REQUIRED");
+	}
+	return value as Record<string, unknown>;
+}
+
+function permissionFields(
+	value: Record<string, unknown>,
+	path: string,
+	required: readonly string[],
+	optional: readonly string[] = [],
+): void {
+	const allowed = new Set([...required, ...optional]);
+	for (const key of Object.keys(value)) {
+		if (!allowed.has(key)) invalidPermissionControl(path, "UNKNOWN_FIELD");
+	}
+	for (const key of required) {
+		if (!Object.hasOwn(value, key)) invalidPermissionControl(path, "MISSING_FIELD");
+	}
