{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "const": "prompt"
      },
      "path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
      },
      "scope": {
        "type": "string",
        "const": "global"
      }
    },
    "required": [
      "kind",
      "path",
      "scope"
    ],
    "additionalProperties": false
  }
}
