{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "const": "node"
        }
      },
      "required": [
        "engine"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "prompts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "catppuccin"
            ]
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "builtin:codemode",
              "builtin:tool-search"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "project_resources": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "catppuccin-latte",
            "catppuccin-frappe",
            "catppuccin-macchiato",
            "catppuccin-mocha"
          ]
        },
        "quietStartup": {
          "type": "string",
          "const": "header"
        },
        "tuiMode": {
          "type": "string",
          "enum": [
            "fullscreen",
            "regular"
          ]
        },
        "editorPaddingX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "outputPad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "autocompleteMaxVisible": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "terminal": {
          "type": "object",
          "properties": {
            "hyperlinks": {
              "type": "string",
              "const": "auto"
            },
            "images": {
              "type": "string",
              "const": "auto"
            },
            "trueColor": {
              "type": "string",
              "const": "auto"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "cacheWarming": {
          "type": "string",
          "enum": [
            "streaming",
            "off",
            "idle"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "defaultThinkingLevel": {
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "steeringMode": {
          "type": "string",
          "enum": [
            "one-at-a-time",
            "all"
          ]
        },
        "followUpMode": {
          "type": "string",
          "enum": [
            "one-at-a-time",
            "all"
          ]
        },
        "compaction": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reserveTokens": {
              "type": "integer",
              "minimum": 1
            },
            "keepRecentTokens": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "retry": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "provider": {
              "type": "object",
              "properties": {
                "maxRetries": {
                  "type": "integer",
                  "const": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "codemode": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ]
            },
            "inlineBudget": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
