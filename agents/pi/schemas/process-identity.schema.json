{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "platform": {
      "enum": [
        "linux",
        "darwin"
      ]
    },
    "boot_id": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "ppid": {
      "type": "integer",
      "minimum": 0
    },
    "pgid": {
      "type": "integer",
      "minimum": 1
    },
    "start_time": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "uid": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "platform",
    "boot_id",
    "pid",
    "ppid",
    "pgid",
    "start_time",
    "namespace",
    "uid"
  ],
  "additionalProperties": false
}
