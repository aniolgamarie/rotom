{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "const": "pi-full"
    },
    "lock_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "lock_identity",
    "runtime_identity",
    "metadata"
  ],
  "additionalProperties": false
}
