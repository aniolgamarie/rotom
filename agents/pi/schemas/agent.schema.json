{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "adapter_version": {
      "type": "string",
      "const": "pi-2"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "agent_options": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "const": "node"
                }
              },
              "required": [
                "engine"
              ],
              "additionalProperties": false
            },
            "resources": {
              "type": "object",
              "properties": {
                "prompts": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000]+$"
                  },
                  "uniqueItems": true
                },
                "themes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "catppuccin"
                    ]
                  },
                  "uniqueItems": true
                },
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "builtin:codemode",
                      "builtin:tool-search"
                    ]
                  },
                  "uniqueItems": true
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "discovery": {
              "type": "object",
              "properties": {
                "project_trust": {
                  "type": "string",
                  "enum": [
                    "deny",
                    "native"
                  ]
                },
                "project_resources": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "ui": {
              "type": "object",
              "properties": {
                "theme": {
                  "type": "string",
                  "enum": [
                    "catppuccin-latte",
                    "catppuccin-frappe",
                    "catppuccin-macchiato",
                    "catppuccin-mocha"
                  ]
                },
                "quietStartup": {
                  "type": "string",
                  "const": "header"
                },
                "tuiMode": {
                  "type": "string",
                  "enum": [
                    "fullscreen",
                    "regular"
                  ]
                },
                "editorPaddingX": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "outputPad": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                },
                "autocompleteMaxVisible": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 20
                },
                "terminal": {
                  "type": "object",
                  "properties": {
                    "hyperlinks": {
                      "type": "string",
                      "const": "auto"
                    },
                    "images": {
                      "type": "string",
                      "const": "auto"
                    },
                    "trueColor": {
                      "type": "string",
                      "const": "auto"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "cacheWarming": {
                  "type": "string",
                  "enum": [
                    "streaming",
                    "off",
                    "idle"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "settings": {
              "type": "object",
              "properties": {
                "defaultTools": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "defaultThinkingLevel": {
                  "type": "string",
                  "enum": [
                    "off",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "steeringMode": {
                  "type": "string",
                  "enum": [
                    "one-at-a-time",
                    "all"
                  ]
                },
                "followUpMode": {
                  "type": "string",
                  "enum": [
                    "one-at-a-time",
                    "all"
                  ]
                },
                "compaction": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "reserveTokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "keepRecentTokens": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "retry": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "maxRetries": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "provider": {
                      "type": "object",
                      "properties": {
                        "maxRetries": {
                          "type": "integer",
                          "const": 0
                        }
                      },
                      "required": [],
                      "additionalProperties": false
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "codemode": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "on",
                        "only"
                      ]
                    },
                    "inlineBudget": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "collaboration": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "prompt"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
          },
          "scope": {
            "type": "string",
            "const": "global"
          }
        },
        "required": [
          "kind",
          "path",
          "scope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "adapter_version",
    "defaults",
    "resources"
  ],
  "additionalProperties": false
}
