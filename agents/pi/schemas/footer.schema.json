{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "enabled": {
      "type": "boolean",
      "const": true
    },
    "preset": {
      "type": "string",
      "const": "default"
    },
    "iconMode": {
      "type": "string",
      "const": "text"
    },
    "minimalist": {
      "type": "boolean"
    },
    "separator": {
      "type": "string",
      "const": "none"
    },
    "separatorFg": {
      "$ref": "#/$defs/foreground"
    },
    "separatorBg": {
      "$ref": "#/$defs/color"
    },
    "terminal": {
      "type": "object",
      "properties": {
        "widthMode": {
          "type": "string",
          "const": "full"
        },
        "colorLevel": {
          "type": "string",
          "const": "ansi256"
        }
      },
      "required": [
        "widthMode",
        "colorLevel"
      ],
      "additionalProperties": false
    },
    "extensionStatusRow": {
      "type": "object",
      "properties": {
        "knownKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hiddenKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "knownKeys",
        "hiddenKeys"
      ],
      "additionalProperties": false
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "event",
                "cwd-basename",
                "git-branch",
                "context-bar",
                "separator",
                "flex-separator",
                "thinking-level"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "options": {
              "type": "object",
              "properties": {
                "widgetId": {
                  "type": "string",
                  "enum": [
                    "agentcfg-selection",
                    "agentcfg-activity",
                    "agentcfg-context",
                    "agentcfg-statistics",
                    "agentcfg-provider",
                    "agentcfg-timing",
                    "agentcfg-tools",
                    "agentcfg-meter"
                  ]
                },
                "hideWhenEmpty": {
                  "type": "boolean"
                },
                "fg": {
                  "$ref": "#/$defs/foreground"
                },
                "bg": {
                  "$ref": "#/$defs/color"
                },
                "bold": {
                  "type": "boolean"
                },
                "raw": {
                  "type": "boolean"
                },
                "icon": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "contextBarMode": {
                  "type": "string",
                  "enum": [
                    "short-only"
                  ]
                },
                "contextConditionalColors": {
                  "type": "boolean"
                },
                "separator": {
                  "type": "string",
                  "enum": [
                    "powerline-right-spaced",
                    "powerline-right",
                    "space",
                    "custom"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "enabled",
            "options"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "event"
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "required": [
                      "widgetId"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "contextBarMode"
                          ]
                        },
                        {
                          "required": [
                            "contextConditionalColors"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "options": {
                    "not": {
                      "required": [
                        "widgetId"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "not": {
                      "const": "context-bar"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "contextBarMode"
                          ]
                        },
                        {
                          "required": [
                            "contextConditionalColors"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "separator"
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "required": [
                      "separator"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "options": {
                    "not": {
                      "required": [
                        "separator"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "flex-separator"
                  }
                }
              },
              "then": {
                "properties": {
                  "options": {
                    "const": {}
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "version",
    "enabled",
    "preset",
    "terminal",
    "iconMode",
    "minimalist",
    "separator",
    "separatorFg",
    "separatorBg",
    "extensionStatusRow",
    "lines"
  ],
  "additionalProperties": false,
  "$defs": {
    "color": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "default",
            "black",
            "red",
            "green",
            "yellow",
            "blue",
            "magenta",
            "cyan",
            "white",
            "brightBlack",
            "brightRed",
            "brightGreen",
            "brightYellow",
            "brightBlue",
            "brightMagenta",
            "brightCyan",
            "brightWhite"
          ]
        },
        {
          "pattern": "^ansi256:(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?![\\s\\S])"
        }
      ]
    },
    "foreground": {
      "anyOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "type": "string",
          "enum": [
            "pi:text",
            "pi:accent",
            "pi:warning",
            "pi:muted",
            "pi:dim"
          ]
        }
      ]
    }
  }
}
