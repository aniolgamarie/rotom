{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "configuration",
              "skill",
              "role",
              "plugin",
              "prompt",
              "theme",
              "service",
              "tool"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "control_domain": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "supported_engines": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "node",
                "bun"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^V[0-9]{2}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "source_id",
          "entrypoints",
          "requires",
          "conflicts",
          "control_domain",
          "supported_engines",
          "evidence_cases"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "npm",
              "git",
              "local",
              "asset"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "commit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "upstream_url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "source_tree_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vendor_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\u0000]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "transform_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "required": [
          "kind",
          "license_files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "capabilities",
    "sources"
  ],
  "additionalProperties": false
}
