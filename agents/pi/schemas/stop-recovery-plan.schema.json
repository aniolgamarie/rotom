{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "old_supervisor_activation_id": {
      "type": "string",
      "minLength": 1
    },
    "old_supervisor_process_identity": {
      "type": "object",
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "darwin"
          ]
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "ppid": {
          "type": "integer",
          "minimum": 0
        },
        "pgid": {
          "type": "integer",
          "minimum": 1
        },
        "start_time": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "platform",
        "boot_id",
        "pid",
        "ppid",
        "pgid",
        "start_time",
        "namespace",
        "uid"
      ],
      "additionalProperties": false
    },
    "old_manager_activation_id": {
      "type": "string",
      "minLength": 1
    },
    "target_process_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "linux",
              "darwin"
            ]
          },
          "boot_id": {
            "type": "string",
            "minLength": 1
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "ppid": {
            "type": "integer",
            "minimum": 0
          },
          "pgid": {
            "type": "integer",
            "minimum": 1
          },
          "start_time": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "uid": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "platform",
          "boot_id",
          "pid",
          "ppid",
          "pgid",
          "start_time",
          "namespace",
          "uid"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "external_work_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workspace_write_lease_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "old_grant_generation": {
      "type": "integer",
      "minimum": 1
    },
    "plan_kind": {
      "enum": [
        "stop_execution",
        "abort_allocation"
      ]
    },
    "allocation_journal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "lease_id",
    "old_supervisor_activation_id",
    "old_supervisor_process_identity",
    "old_manager_activation_id",
    "target_process_identities",
    "external_work_ids",
    "workspace_write_lease_ids",
    "old_grant_generation",
    "plan_kind",
    "allocation_journal_digest",
    "plan_digest",
    "created_at",
    "expires_at"
  ],
  "additionalProperties": false
}
