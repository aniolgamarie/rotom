    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "tinyfish",
    "search1api",
    "searchinfinity",
    "querit",
    "perplexity",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/nicobailon/pi-web-access/issues"
  },
  "homepage": "https://github.com/nicobailon/pi-web-access#readme",
  "files": [
    "*.ts",
    "CHANGELOG.md",
    "SECURITY.md",
    "banner.png",
    "pi-web-fetch-demo.mp4",
    "LICENSE",
    "NOTICE.agentcfg.md",
