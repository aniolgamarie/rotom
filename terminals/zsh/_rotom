local -a _rotom_value_options=(--adopt-target --agent --base --batch --component --confirm-zshenv --cwd --depth --entry --entry-repo --exclude --existing-branch --format --from-pi-home --home --id --inherit-env --label --local --machine --mode --new-branch --operation --path --plan-id --plugin --profile --protocol --proxy --repo --run --scope --session --source --start-path --template --timeout --title --unset-env --version --wait-seconds)
local -a _rotom_flags=(--accept --adopt-target --agent --base --batch --component --confirm-zshenv --cwd --depth --drop-mihomo --dry-run --edit --enter --entry --entry-repo --environment --exclude --existing-branch --follow-symlinks --format --from-pi-home --help --here --home --id --include-hidden --inherit-env --input --interactive --json --label --list --live --local --machine --mode --new --new-branch --new-tab --no-input --none --operation --original --path --plan-id --plan-only --plugin --profile --protocol --proxy --repo --run --scope --session --source --start-path --stopped --strict --template --timeout --title --unset-env --verbose --version --wait-seconds --yes -h --all)

# 先收集并校验完整NUL响应，再作为值交给compadd；错误静默退回静态候选。
_rotom_ids() {
  emulate -L zsh
  local raw id
  local -a ids
  raw="$(command rotom _complete "$@" 2>/dev/null)" || return 1
  [[ -n "$raw" && "$raw" == *$'\0' ]] || return 1
  [[ "$raw" != $'\0'* && "$raw" != *$'\0\0'* ]] || return 1
  raw="${raw%$'\0'}"
  ids=("${(@0)raw}")
  for id in "${ids[@]}"; do
    [[ -n "$id" && ${#id} -le 255 && "$id" == [[:alnum:]_]* && "$id" != *[^[:alnum:]_.-]* ]] || return 1
  done
  compadd -a ids
}

local _rotom_path=_root token option value need="" cur="${words[CURRENT]}"
local machine="" local_path="" profile="" tool="" kind="" namespace="" value_option=""
local -a children _rotom_option_words positions query enum_words
integer index machine_seen=0 local_seen=0 profile_seen=0 tool_seen=0

# 只解释光标前的管理token；原生边界后的任何字词均不再查询。
for (( index=2; index<CURRENT; index++ )); do
  token="${words[index]}"
  [[ "$token" == -- ]] && return 1
  [[ "$_rotom_path" == "agent usage" ]] && return 1
  if [[ -z "$need" && "$token" == -* ]]; then
    option="${token%%=*}"
    _rotom_option_words=("${(@s: :)_rotom_options[$_rotom_path]}")
    (( ${_rotom_option_words[(Ie)$option]} )) || return 1
  fi
  if [[ -n "$need" ]]; then
    option="$need"
    value="$token"
    need=""
  elif [[ "$token" == --*=* ]]; then
    option="${token%%=*}"
    value="${token#*=}"
    (( ${_rotom_value_options[(Ie)$option]} )) || return 1
  elif (( ${_rotom_value_options[(Ie)$token]} )); then
    need="$token"
    continue
  elif [[ "$token" == -* ]]; then
    (( ${_rotom_flags[(Ie)$token]} )) || return 1
    continue
  else
    children=("${(@s: :)_rotom_commands[$_rotom_path]}")
    if (( ${children[(Ie)$token]} )); then
      if [[ "$_rotom_path" == _root ]]; then
        _rotom_path="$token"
      else
        _rotom_path="$_rotom_path $token"
      fi
    else
      if [[ "$_rotom_path" == (run|resume|"agent run") && ${#positions} -eq 0 && "$token" == (dsh|pi|omp) ]]; then
        tool="$token"
        (( ++tool_seen ))
      fi
      positions+=("$token")
    fi
    continue
  fi
  case "$option" in
    --machine) machine="$value"; (( ++machine_seen )) ;;
    --local) local_path="$value"; (( ++local_seen )) ;;
    --profile) profile="$value"; (( ++profile_seen )) ;;
    --tool|--agent) tool="$value"; (( ++tool_seen )) ;;
  esac
done
[[ "$_rotom_path" == "agent usage" ]] && return 1
(( machine_seen <= 1 && local_seen <= 1 && profile_seen <= 1 && tool_seen <= 1 )) || return 1
(( machine_seen == 0 || local_seen == 0 )) || return 1
case "$_rotom_path" in
  run|resume|agent|agent\ *) namespace=agent ;;
  term|term\ *) namespace=term ;;
  work|work\ *) namespace=work ;;
esac

value_option="$need"
if [[ "$cur" == --*=* ]]; then
  value_option="${cur%%=*}"
  _rotom_option_words=("${(@s: :)_rotom_options[$_rotom_path]}")
  (( ${_rotom_option_words[(Ie)$value_option]} )) || return 1
  compset -P '*='
fi
# 非动态枚举来自同一parser快照；动态kind仍走受限协议按操作过滤。
if [[ -n "$value_option" && "$value_option" != (--machine|--profile|--agent|--tool|--component|--template|--session) ]]; then
  enum_words=("${(@s: :)_rotom_enums[$_rotom_path|$value_option]}")
  if [[ -n "${enum_words[1]}" ]]; then
    compadd -a enum_words
    return
  fi
fi
case "$value_option" in
  --machine) kind=machine ;;
  --profile) kind=profile ;;
  --agent|--tool) kind=tool ;;
  --component) kind=component ;;
  --template) [[ "$namespace" == work ]] && kind=work-template ;;
  --session) [[ "$_rotom_path" == resume ]] && kind=session ;;
  "") ;;
  *) return 1 ;;
esac
if [[ -z "$value_option" ]]; then
  case "$_rotom_path" in
    run|resume|"agent run") (( ${#positions} == 0 )) && kind=tool ;;
    "agent model key"|"agent model url") (( ${#positions} == 0 )) && kind=provider ;;
    "agent model enable") (( ${#positions} == 0 )) && kind=preset ;;
    "work open"|"work rebind") (( ${#positions} == 0 )) && kind=work-type ;;
    "work named enter"|"work named rename") (( ${#positions} == 0 )) && kind=work-named ;;
    "config set"|"config unset") (( ${#positions} == 0 )) && kind=preference-key ;;
  esac
fi

if [[ -n "$kind" && ( -n "$value_option" || "$cur" != -* ) ]]; then
  query=(--kind "$kind")
  case "$kind" in
    machine)
      [[ -n "$namespace" ]] || return 1
      query+=(--namespace "$namespace")
      ;;
    provider|work-type|work-template|work-named|session)
      [[ -n "$machine" || -n "$local_path" ]] || return 1
      [[ -n "$machine" ]] && query+=(--machine "$machine")
      [[ -n "$local_path" ]] && query+=(--local "$local_path")
      query+=(--namespace "$namespace")
      if [[ "$kind" == provider ]]; then
        [[ -n "$profile" ]] || return 1
        query+=(--profile "$profile")
      elif [[ "$kind" == session ]]; then
        [[ -n "$tool" ]] || return 1
        [[ -n "$profile" ]] && query+=(--profile "$profile")
        query+=(--tool "$tool")
      fi
      ;;
    profile)
      [[ -n "$tool" ]] && query+=(--tool "$tool")
      ;;
  esac
  # 只传注册叶子；正在选择命令的中间路径没有动态操作范围。
  if [[ "$kind" != preference-key ]] && (( ${_rotom_leaves[(Ie)$_rotom_path]} )); then
    query+=(--command "$_rotom_path")
  fi
  _rotom_ids "${query[@]}" && return 0
fi

# 所有候选都是固定命令/参数或协议返回的ID；没有通用文件系统/原生宿主兜底。
_rotom_option_words=("${(@s: :)_rotom_options[$_rotom_path]}")
children=("${(@s: :)_rotom_commands[$_rotom_path]}")
if [[ -z "$value_option" && "$cur" != -* && -n "${children[1]}" ]]; then
  compadd -a children
else
  compadd -a _rotom_option_words
fi
