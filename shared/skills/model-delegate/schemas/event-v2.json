{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "kind": {
      "type": "string",
      "enum": [
        "ready",
        "checkpoint",
        "completed",
        "failed",
        "canceled",
        "timeout"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "started",
        "tool-completed",
        "turn-completed",
        "terminated"
      ]
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,200}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "timestamp",
    "kind",
    "phase",
    "artifact_id"
  ],
  "additionalProperties": false
}
