# Optional private ~/.config/termcfg/zshrc.local.
# This file is sourced by the public zsh configuration. Keep its real copy outside Git.
# Use it for machine-specific paths, shell preferences, and explicitly chosen helpers.

# Example: a local completion directory. No implicit download or repository path.
fpath=("$HOME/.zsh/completions" $fpath)

# Example: an optional user-managed tool directory.
path=("$HOME/.local/bin" $path)
export PATH
