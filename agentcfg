#!/usr/bin/env python3
"""agentcfg 可执行入口

直接使用仓库 .venv 的 Python，缺失时提示 uv sync --locked。
不以普通 uv run 包装离线命令（LOCK-01）。
"""

import sys
from pathlib import Path

# 定位仓库根和虚拟环境
REPO_ROOT = Path(__file__).resolve().parent
VENV_PYTHON = REPO_ROOT / ".venv" / "bin" / "python"


def main() -> int:
    # 虚拟环境 Python 常与系统 Python 指向同一文件，须比较环境前缀。
    if VENV_PYTHON.exists() and Path(sys.prefix).resolve() == (REPO_ROOT / ".venv").resolve():
        sys.path.insert(0, str(REPO_ROOT / "src"))
        from agentcfg.cli import main as cli_main
        return cli_main()

    # 尝试使用 .venv 的 Python 重新执行
    if VENV_PYTHON.exists():
        import os
        os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__] + sys.argv[1:])

    # .venv 不存在，提示初始化
    print(
        "错误: 虚拟环境未找到\n"
        "请先执行: uv sync --locked\n"
        f"期望路径: {VENV_PYTHON}",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
